<%
  var msg = (typeof msg !== "undefined" && msg) ? String(msg) : "";
  var error = (typeof error !== "undefined" && error) ? String(error) : "";
  var ok = (typeof ok !== "undefined" && ok) ? String(ok) : "";
  var showError = !!(error || msg);
%>

<div class="card" style="max-width:560px; margin: 0 auto;">
  <h1 style="margin:0;">Bunca Rösterei</h1>
  <p class="small-note" style="margin-top:6px;">Produktions- und Bestellsystem</p>

  <div style="margin-top:18px;">
    <h2 style="margin:0;">Anmelden</h2>
    <p class="small-note" style="margin-top:6px;">Bitte melden Sie sich mit Ihrem Benutzer an.</p>
  </div>

  <% if (ok) { %>
    <div class="card mt-3" style="border-color: rgba(38,201,122,.35);">
      <h2>OK</h2>
      <p><%= ok %></p>
    </div>
  <% } %>

  <% if (showError) { %>
    <div class="card mt-3" style="border-color: rgba(255,77,77,.35);">
      <h2>Fehler</h2>
      <p><%= error || msg %></p>
    </div>
  <% } %>

  <form method="POST" action="/login" style="margin-top:18px;">
    <div style="display:grid; gap:12px;">
      <div>
        <div class="small-note">E-Mail</div>
        <input class="input" name="email" type="email" placeholder="z.B. admin@bunca.local" required />
      </div>

      <div>
        <div class="small-note">Passwort</div>
        <input class="input" name="password" type="password" placeholder="Ihr Passwort" required />
      </div>

      <button class="btn btn-primary" type="submit" style="width:100%;">Login</button>
    </div>
  </form>

  <div class="small-note" style="margin-top:16px;">
    Admin Default: <span class="mono">admin@bunca.local</span> / <span class="mono">Admin123!</span><br/>
    Filialen: <span class="mono">city@bunca.local</span>, <span class="mono">berger@bunca.local</span>, <span class="mono">gruen@bunca.local</span> (Passwort: <span class="mono">Shop123!</span>)
  </div>
</div>
