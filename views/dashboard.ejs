<%
  var ordersCount = (typeof ordersCount !== "undefined") ? ordersCount : 0;
  var demandCount = (typeof demandCount !== "undefined") ? demandCount : 0;
  var batchCount = (typeof batchCount !== "undefined") ? batchCount : 0;
  var activityCount = (typeof activityCount !== "undefined") ? activityCount : 0;
  var inventoryUpdatedAt = (typeof inventoryUpdatedAt !== "undefined") ? inventoryUpdatedAt : null;

  var shopMode = (typeof shopMode !== "undefined") ? shopMode : false;
  var shopId = (typeof shopId !== "undefined") ? shopId : null;
  var shopStatusCounts = (typeof shopStatusCounts !== "undefined") ? shopStatusCounts : null;
  var shopNextDelivery = (typeof shopNextDelivery !== "undefined") ? shopNextDelivery : null;

  function fmt(at){
    if (!at) return "-";
    return String(at).slice(0,19).replace("T"," ");
  }

  function n(v){ return (v===undefined || v===null) ? 0 : Number(v); }
%>

<% if (shopMode) { %>

  <div class="card-grid">
    <div class="card">
      <h2>Filiale Dashboard</h2>
      <p>Sie können Bestellungen anlegen und den Status verfolgen. Freigabe, Produktion und Auslieferung übernimmt die Rösterei.</p>
    </div>

    <div class="card">
      <h2>Info</h2>
      <p>
        Filiale: <strong><%= shopId || "-" %></strong><br/>
        Meine Bestellungen: <strong><%= ordersCount %></strong><br/>
        Nächste Lieferung: <strong class="mono"><%= shopNextDelivery || "-" %></strong>
      </p>
    </div>
  </div>

  <div class="section">
    <div class="section-head">
      <div>
        <div class="section-title">Status Übersicht</div>
        <div class="section-sub">So sehen Sie sofort, wo Ihre Bestellungen stehen.</div>
      </div>
      <div class="spacer"></div>
      <a class="btn btn-sm btn-primary" href="/orders#new"><span class="btn-icon"></span>Neue Bestellung</a>
    </div>

    <div class="section-body">
      <div class="card-grid" style="grid-template-columns: repeat(5, minmax(0, 1fr));">
        <div class="card">
          <h2>Eingegangen</h2>
          <p><strong class="mono" style="font-size:22px;"><%= n(shopStatusCounts && shopStatusCounts.EINGEGANGEN) %></strong></p>
        </div>
        <div class="card">
          <h2>Freigegeben</h2>
          <p><strong class="mono" style="font-size:22px;"><%= n(shopStatusCounts && shopStatusCounts.FREIGEGEBEN) %></strong></p>
        </div>
        <div class="card">
          <h2>In Produktion</h2>
          <p><strong class="mono" style="font-size:22px;"><%= n(shopStatusCounts && shopStatusCounts.IN_PRODUKTION) %></strong></p>
        </div>
        <div class="card">
          <h2>Verpackt</h2>
          <p><strong class="mono" style="font-size:22px;"><%= n(shopStatusCounts && shopStatusCounts.VERPACKT) %></strong></p>
        </div>
        <div class="card">
          <h2>Ausgeliefert</h2>
          <p><strong class="mono" style="font-size:22px;"><%= n(shopStatusCounts && shopStatusCounts.AUSGELIEFERT) %></strong></p>
        </div>
      </div>

      <div class="card mt-4">
        <h2>Was kann ich hier tun?</h2>
        <p>
          1) Neue Bestellung anlegen<br/>
          2) Status verfolgen (Eingegangen → Freigegeben → …)<br/>
          3) Bei Fragen: Bestell-ID notieren und an Rösterei schicken
        </p>
        <div class="row mt-3">
          <a class="btn btn-primary" href="/orders"><span class="btn-icon"></span>Zu meinen Bestellungen</a>
          <a class="btn btn-ghost" href="/orders#new">Neue Bestellung</a>
        </div>
      </div>
    </div>
  </div>

<% } else { %>

  <!-- ADMIN dashboard (existing enhanced version) -->
  <div class="card-grid">
    <div class="card">
      <h2>Heute im Blick</h2>
      <p>Dashboard ist dein Kontrollzentrum: schnelle Übersicht, klare Aktionen, weniger Hin und Her zwischen Seiten.</p>
    </div>

    <div class="card">
      <h2>Status</h2>
      <p>
        Letztes Lager-Update: <span class="mono"><%= fmt(inventoryUpdatedAt) %></span><br/>
        Aktivität (Log): <strong><%= activityCount %></strong> Einträge
      </p>
    </div>
  </div>

  <div class="section">
    <div class="section-head">
      <div>
        <div class="section-title">KPIs</div>
        <div class="section-sub">Schnelle Zahlen. Ziel: sofort wissen, wo der Fokus liegt.</div>
      </div>
      <div class="spacer"></div>
      <a class="btn btn-sm btn-ghost" href="/activity">Audit Log</a>
    </div>

    <div class="section-body">
      <div class="card-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr));">
        <div class="card">
          <h2>Bestellungen</h2>
          <p><strong class="mono" style="font-size:22px;"><%= ordersCount %></strong><br/><span class="small-note">gesamt</span></p>
          <div class="row mt-3">
            <a class="btn btn-sm btn-primary" href="/orders"><span class="btn-icon"></span>Öffnen</a>
          </div>
        </div>

        <div class="card">
          <h2>Bedarf</h2>
          <p><strong class="mono" style="font-size:22px;"><%= demandCount %></strong><br/><span class="small-note">Sorten</span></p>
          <div class="row mt-3">
            <a class="btn btn-sm btn-primary" href="/production"><span class="btn-icon"></span>Planen</a>
          </div>
        </div>

        <div class="card">
          <h2>Chargen</h2>
          <p><strong class="mono" style="font-size:22px;"><%= batchCount %></strong><br/><span class="small-note">im System</span></p>
          <div class="row mt-3">
            <a class="btn btn-sm btn-primary" href="/production"><span class="btn-icon"></span>Tracken</a>
          </div>
        </div>

        <div class="card">
          <h2>Lager</h2>
          <p><strong class="mono" style="font-size:22px;">OK</strong><br/><span class="small-note">Details im Lager</span></p>
          <div class="row mt-3">
            <a class="btn btn-sm btn-primary" href="/inventory"><span class="btn-icon"></span>Prüfen</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-head">
      <div>
        <div class="section-title">Quick Actions</div>
        <div class="section-sub">Die 3 wichtigsten Aktionen für den Alltag.</div>
      </div>
      <div class="spacer"></div>
      <button class="btn btn-sm btn-ghost" type="button" data-to-top>Nach oben</button>
    </div>

    <div class="section-body">
      <div class="card-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
        <div class="card">
          <h2>Neue Bestellung</h2>
          <p>Schnell erfassen und freigeben.</p>
          <div class="row mt-3">
            <a class="btn btn-primary" href="/orders#new"><span class="btn-icon"></span>Start</a>
            <a class="btn btn-ghost" href="/orders">Liste</a>
          </div>
        </div>

        <div class="card">
          <h2>Bestand ändern</h2>
          <p>Roh oder Röst korrigieren.</p>
          <div class="row mt-3">
            <a class="btn btn-primary" href="/inventory#apply"><span class="btn-icon"></span>Ändern</a>
            <a class="btn btn-ghost" href="/activity">Log</a>
          </div>
        </div>

        <div class="card">
          <h2>Charge anlegen</h2>
          <p>Aus Bedarf eine Charge planen.</p>
          <div class="row mt-3">
            <a class="btn btn-primary" href="/production"><span class="btn-icon"></span>Produktion</a>
            <a class="btn btn-ghost" href="/orders">Freigaben</a>
          </div>
        </div>
      </div>
    </div>
  </div>

<% } %>
