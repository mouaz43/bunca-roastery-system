<%
  const cards = (typeof cards !== "undefined" && cards) ? cards : [];
  const moves = (typeof moves !== "undefined" && moves) ? moves : [];
  const updatedAt = (typeof updatedAt !== "undefined" && updatedAt) ? updatedAt : "";
%>

<style>
  .inv-grid{ display:grid; gap:14px; grid-template-columns: 1fr; }
  @media (min-width:1100px){ .inv-grid{ grid-template-columns: 1.2fr .8fr; } }

  .kpis{ display:grid; gap:10px; grid-template-columns: repeat(2, minmax(0,1fr)); }
  @media (min-width:700px){ .kpis{ grid-template-columns: repeat(4, minmax(0,1fr)); } }

  .kpi{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.65);
  }
  .kpi .label{ font-size:12px; opacity:.7; font-weight:900; }
  .kpi .val{ font-size:18px; font-weight:950; margin-top:6px; }

  .stock-list{ display:grid; gap:10px; }
  .stock{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.65);
    display:grid;
    grid-template-columns: 1fr 140px 140px;
    gap:10px;
    align-items:center;
  }
  @media (max-width:800px){ .stock{ grid-template-columns:1fr; } }
  .stock .name{ font-weight:950; }
  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding:8px 10px; border-radius:999px;
    border:1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.55);
    font-weight:900; font-size:12px;
  }
  .pill .dot{ width:8px; height:8px; border-radius:999px; background: rgba(0,0,0,.25); }
  .pill.ok{ border-color: rgba(38,201,122,.35); background: rgba(38,201,122,.08); }
  .pill.ok .dot{ background: rgba(38,201,122,.9); }
  .pill.warn{ border-color: rgba(255,168,0,.35); background: rgba(255,168,0,.10); }
  .pill.warn .dot{ background: rgba(255,168,0,.95); }
  .pill.low{ border-color: rgba(255,77,77,.35); background: rgba(255,77,77,.08); }
  .pill.low .dot{ background: rgba(255,77,77,.9); }

  .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  .right{ text-align:right; }
</style>

<div class="inv-grid">

  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:flex-start;">
      <div>
        <h2 style="margin:0;">Lagerübersicht</h2>
        <div class="small-note">Stand: <span class="mono"><%= updatedAt %></span></div>
      </div>
      <span class="pill ok"><span class="dot"></span>Admin</span>
    </div>

    <div class="kpis mt-3">
      <div class="kpi">
        <div class="label">Sorten</div>
        <div class="val"><%= cards.length %></div>
      </div>
      <div class="kpi">
        <div class="label">Warnungen</div>
        <div class="val"><%= cards.filter(x=>x.level==="warn").length %></div>
      </div>
      <div class="kpi">
        <div class="label">Kritisch</div>
        <div class="val"><%= cards.filter(x=>x.level==="low").length %></div>
      </div>
      <div class="kpi">
        <div class="label">OK</div>
        <div class="val"><%= cards.filter(x=>x.level==="ok").length %></div>
      </div>
    </div>

    <div class="stock-list mt-3">
      <% cards.forEach(c => { %>
        <div class="stock">
          <div>
            <div class="name"><%= c.name %></div>
            <div class="small-note mono"><%= c.id %> · Pack <%= (c.packDefaultKg||1) %>kg</div>
          </div>

          <div>
            <div class="small-note">Grün (kg)</div>
            <div class="mono" style="font-weight:950;"><%= (c.green||0).toFixed(1) %></div>
          </div>

          <div>
            <div class="small-note">Röst (kg)</div>
            <div class="mono" style="font-weight:950;"><%= (c.roasted||0).toFixed(1) %></div>
          </div>

          <div style="grid-column: 1/-1;">
            <span class="pill <%= c.level %>">
              <span class="dot"></span>
              <%= c.level==="ok" ? "OK" : (c.level==="warn" ? "Achtung" : "Kritisch") %>
            </span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <h2 style="margin:0;">Letzte Lagerbewegungen</h2>
    <div class="small-note">Die letzten 10 Aktionen (Wareneingang/Korrektur/Move).</div>

    <div class="mt-3" style="display:grid; gap:10px;">
      <% if (!moves.length) { %>
        <div class="small-note">Noch keine Lager-Aktionen vorhanden.</div>
      <% } %>

      <% moves.forEach(m => { %>
        <div class="order-card">
          <div class="row" style="justify-content:space-between;">
            <div style="font-weight:950;"><%= m.action %></div>
            <div class="mono small-note"><%= m.at %></div>
          </div>
          <pre class="mono small-note" style="white-space:pre-wrap; margin:10px 0 0;"><%= JSON.stringify(m.meta || {}, null, 2) %></pre>
        </div>
      <% }) %>
    </div>
  </div>

</div>
