<%
  var inv = (typeof inventory !== "undefined" && inventory) ? inventory : null;
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];

  function g(coffeeId){
    if (!inv || !inv.greenBeansKg) return 0;
    var v = inv.greenBeansKg[coffeeId];
    return (v === undefined || v === null) ? 0 : Number(v);
  }

  function r(coffeeId){
    if (!inv || !inv.roastedKg) return 0;
    var v = inv.roastedKg[coffeeId];
    return (v === undefined || v === null) ? 0 : Number(v);
  }

  function fmtUpdated(){
    if (!inv || !inv.updatedAt) return "-";
    return String(inv.updatedAt).slice(0,19).replace("T"," ");
  }

  // Thresholds (we will move to settings later)
  function minGreen(){ return 25; }
  function minRoasted(){ return 10; }

  function badge(value, min){
    if (value <= 0) return { cls:"badge danger", label:"Kritisch" };
    if (value < min) return { cls:"badge warn", label:"Niedrig" };
    return { cls:"badge ok", label:"OK" };
  }

  function needNote(value, min){
    if (value <= 0) return "Sofort prüfen (Bestand fehlt).";
    if (value < min) return "Bald nachbestellen oder Produktion planen.";
    return "Im grünen Bereich.";
  }

  function totalGreen(){
    var t=0;
    for (var i=0;i<coffees.length;i++) t += g(coffees[i].id);
    return t;
  }
  function totalRoasted(){
    var t=0;
    for (var i=0;i<coffees.length;i++) t += r(coffees[i].id);
    return t;
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Lager</h2>
    <p>Rohkaffee und Röstkaffee pro Sorte. Änderungen werden protokolliert und beeinflussen Produktion und Auslieferung.</p>
  </div>

  <div class="card">
    <h2>Übersicht</h2>
    <p>
      Roh gesamt: <strong><%= totalGreen() %> kg</strong><br/>
      Röst gesamt: <strong><%= totalRoasted() %> kg</strong><br/>
      Letztes Update: <span class="mono"><%= fmtUpdated() %></span>
    </p>
  </div>
</div>

<div class="filterbar">
  <div class="filter-left">
    <a class="btn btn-sm btn-ghost" href="/orders">Bestellungen</a>
    <a class="btn btn-sm btn-ghost" href="/production">Produktion</a>
    <a class="btn btn-sm btn-ghost" href="/activity">Aktivität</a>
  </div>

  <div class="filter-right">
    <a class="btn btn-primary" href="#apply">
      <span class="btn-icon" aria-hidden="true"></span>
      Bestand ändern
    </a>
  </div>
</div>

<!-- INVENTORY TABLE -->
<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Bestandsübersicht</div>
      <div class="section-sub">Warnstufen: Roh unter <%= minGreen() %> kg, Röst unter <%= minRoasted() %> kg.</div>
    </div>
    <div class="spacer"></div>
    <div class="badge info"><span class="dot"></span><%= coffees.length %> Sorten</div>
  </div>

  <div class="section-body" style="padding:0;">
    <div class="table-wrap" style="border-radius:0; border-left:none; border-right:none; border-bottom:none;">
      <div class="table-head" style="grid-template-columns: 1fr 140px 140px 160px 160px 280px;">
        <div>Sorte</div>
        <div class="right">Roh kg</div>
        <div class="right">Röst kg</div>
        <div>Roh Status</div>
        <div>Röst Status</div>
        <div class="right">Hinweis</div>
      </div>

      <% if (!coffees.length) { %>
        <div class="table-row" style="grid-template-columns: 1fr;">
          <div class="card" style="margin:14px;">
            <h2>Keine Sorten</h2>
            <p>Es sind keine Kaffeesorten hinterlegt. Bitte in Einstellungen Stammdaten pflegen.</p>
            <div class="row" style="margin-top:12px;">
              <a class="btn btn-primary" href="/settings"><span class="btn-icon"></span>Einstellungen</a>
            </div>
          </div>
        </div>
      <% } %>

      <% for (var i=0; i<coffees.length; i++) {
          var c = coffees[i];
          var gg = g(c.id);
          var rr = r(c.id);
          var bg = badge(gg, minGreen());
          var br = badge(rr, minRoasted());
      %>
        <div class="table-row" style="grid-template-columns: 1fr 140px 140px 160px 160px 280px;">
          <div>
            <div style="font-weight:950;"><%= c.name %></div>
            <div class="small-note mono"><%= c.id %></div>
          </div>

          <div class="right mono"><strong><%= gg %></strong></div>
          <div class="right mono"><strong><%= rr %></strong></div>

          <div><span class="<%= bg.cls %>"><span class="dot"></span><%= bg.label %></span></div>
          <div><span class="<%= br.cls %>"><span class="dot"></span><%= br.label %></span></div>

          <div class="right small-note">
            <div><strong>Roh:</strong> <%= needNote(gg, minGreen()) %></div>
            <div style="margin-top:6px;"><strong>Röst:</strong> <%= needNote(rr, minRoasted()) %></div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- APPLY CHANGE -->
<div id="apply" class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Bestand ändern</div>
      <div class="section-sub">Änderung in kg eingeben (z.B. +10 oder -5). Typ auswählen: Roh oder Röst.</div>
    </div>
    <div class="spacer"></div>
    <a class="btn btn-sm btn-ghost" href="#top">Nach oben</a>
  </div>

  <div class="section-body">
    <form method="POST" action="/actions/inventory/apply">
      <div class="filterbar">
        <div class="filter-left">
          <select class="select" name="type">
            <option value="GREEN">Typ: Rohkaffee</option>
            <option value="ROASTED">Typ: Röstkaffee</option>
          </select>

          <select class="select" name="coffeeId" style="min-width:240px;">
            <option value="">Sorte wählen</option>
            <% for (var j=0; j<coffees.length; j++) { %>
              <option value="<%= coffees[j].id %>"><%= coffees[j].name %></option>
            <% } %>
          </select>

          <input class="input" name="deltaKg" placeholder="Menge kg (z.B. +10 oder -5)" style="min-width:240px;" />
          <input class="input" name="note" placeholder="Grund (optional) – Lieferung, Korrektur, Produktion" style="min-width:280px;" />
        </div>

        <div class="filter-right">
          <button class="btn btn-sm btn-ghost" type="reset">Zurücksetzen</button>
          <button class="btn btn-primary" type="submit">
            <span class="btn-icon" aria-hidden="true"></span>
            Übernehmen
          </button>
        </div>
      </div>
    </form>

    <div class="card mt-3">
      <h2>Pro-Tipp (Workflow)</h2>
      <p>
        Nach dem Rösten: Batch-Status auf <strong>Geröstet</strong> setzen, damit Roh → Röst automatisch bewegt wird.<br/>
        Nach Auslieferung: Bestellung <strong>Ausliefern</strong> buchen, damit Röstkaffee reduziert wird.
      </p>
    </div>
  </div>
</div>
