<%
  var demand = (typeof roastDemand !== "undefined" && roastDemand) ? roastDemand : [];
  var inv = (typeof inventory !== "undefined" && inventory) ? inventory : null;
  var batches = (typeof batches !== "undefined" && batches) ? batches : [];

  function getGreen(coffeeId){
    if (!inv || !inv.greenBeansKg) return 0;
    var v = inv.greenBeansKg[coffeeId];
    return (v === undefined || v === null) ? 0 : Number(v);
  }

  function getRoasted(coffeeId){
    if (!inv || !inv.roastedKg) return 0;
    var v = inv.roastedKg[coffeeId];
    return (v === undefined || v === null) ? 0 : Number(v);
  }

  function shortId(id){
    if (!id) return "-";
    var s = String(id);
    return s.length >= 8 ? s.slice(0,8) : s;
  }

  function fmt(at){
    if (!at) return "-";
    return String(at).slice(0,19).replace("T"," ");
  }

  function statusBadge(status){
    var map = {
      "GEPLANT": { cls:"badge warn", label:"Geplant" },
      "GEROESTET": { cls:"badge ok", label:"Geröstet" },
      "ABGEKUEHLT": { cls:"badge info", label:"Abgekühlt" },
      "VERPACKT": { cls:"badge ok", label:"Verpackt" },
      "BEREIT": { cls:"badge info", label:"Bereit" },
      "AUSGELIEFERT": { cls:"badge", label:"Ausgeliefert" }
    };
    return map[status] || { cls:"badge", label:(status || "-") };
  }

  function riskBadge(needFromGreen, green){
    if (needFromGreen <= 0) return { cls:"badge ok", label:"Puffer vorhanden" };
    if (green >= needFromGreen) return { cls:"badge ok", label:"Roh ausreichend" };
    if (green > 0 && green < needFromGreen) return { cls:"badge warn", label:"Roh knapp" };
    return { cls:"badge danger", label:"Roh fehlt" };
  }

  function sumDemand(){
    var t=0;
    for (var i=0;i<demand.length;i++){
      var n = Number(demand[i].kg);
      if (!isNaN(n)) t += n;
    }
    return t;
  }

  function sumPlannedBatches(){
    var t=0;
    for (var i=0;i<batches.length;i++){
      var b = batches[i];
      if (!b) continue;
      if (b.status === "GEPLANT") t += Number(b.kg || 0);
    }
    return t;
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Produktion</h2>
    <p>Bedarf aus freigegebenen Bestellungen. Chargen planen und Status verfolgen. Lagerbewegungen passieren automatisch bei Statuswechsel.</p>
  </div>

  <div class="card">
    <h2>Übersicht</h2>
    <p>
      Bedarf gesamt: <strong><%= sumDemand() %> kg</strong><br/>
      Geplante Chargen: <strong><%= sumPlannedBatches() %> kg</strong><br/>
      Chargen: <strong><%= batches.length %></strong>
    </p>
  </div>
</div>

<div class="filterbar">
  <div class="filter-left">
    <a class="btn btn-sm btn-ghost" href="/orders">Bestellungen</a>
    <a class="btn btn-sm btn-ghost" href="/inventory">Lager</a>
    <a class="btn btn-sm btn-ghost" href="/activity">Aktivität</a>
  </div>
  <div class="filter-right">
    <a class="btn btn-primary" href="#batches">
      <span class="btn-icon" aria-hidden="true"></span>
      Zu Chargen
    </a>
  </div>
</div>

<!-- DEMAND -->
<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Röstbedarf</div>
      <div class="section-sub">Bedarf basiert auf Status: Freigegeben, In Produktion, Verpackt. Puffer = vorhandener Röstkaffee.</div>
    </div>
    <div class="spacer"></div>
    <div class="badge info"><span class="dot"></span><%= demand.length %> Sorten</div>
  </div>

  <div class="section-body" style="padding:0;">
    <div class="table-wrap" style="border-radius:0; border-left:none; border-right:none; border-bottom:none;">
      <div class="table-head" style="grid-template-columns: 1fr 120px 130px 130px 160px 360px;">
        <div>Sorte</div>
        <div class="right">Bedarf</div>
        <div class="right">Röst</div>
        <div class="right">Roh</div>
        <div>Status</div>
        <div class="right">Charge anlegen</div>
      </div>

      <% if (!demand.length) { %>
        <div class="table-row" style="grid-template-columns: 1fr;">
          <div class="card" style="margin:14px;">
            <h2>Kein Bedarf</h2>
            <p>Es gibt aktuell keine freigegebenen Bestellungen, die Röstbedarf erzeugen.</p>
            <div class="row" style="margin-top:12px;">
              <a class="btn btn-primary" href="/orders"><span class="btn-icon"></span>Zu Bestellungen</a>
              <a class="btn btn-ghost" href="/inventory">Lager prüfen</a>
            </div>
          </div>
        </div>
      <% } %>

      <% for (var i=0; i<demand.length; i++){
          var d = demand[i];
          var green = getGreen(d.coffeeId);
          var roasted = getRoasted(d.coffeeId);
          var needFromGreen = d.kg - roasted;
          if (needFromGreen < 0) needFromGreen = 0;
          var risk = riskBadge(needFromGreen, green);
      %>
        <div class="table-row" style="grid-template-columns: 1fr 120px 130px 130px 160px 360px;">
          <div>
            <div style="font-weight:950;"><%= d.coffeeName %></div>
            <div class="small-note mono"><%= d.coffeeId %></div>
          </div>

          <div class="right mono"><strong><%= d.kg %></strong></div>
          <div class="right mono"><strong><%= roasted %></strong></div>
          <div class="right mono"><strong><%= green %></strong></div>

          <div><span class="<%= risk.cls %>"><span class="dot"></span><%= risk.label %></span></div>

          <div class="row-actions">
            <form method="POST" action="/actions/batches/create" style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">
              <input type="hidden" name="coffeeId" value="<%= d.coffeeId %>" />
              <input class="input" name="kg" placeholder="kg (z.B. 12)" style="width:140px; height:40px;" />
              <input class="input" name="note" placeholder="Notiz (optional)" style="width:200px; height:40px;" />
              <button class="btn btn-sm btn-primary" type="submit">
                <span class="btn-icon" aria-hidden="true"></span>
                Anlegen
              </button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- BATCHES -->
<div id="batches" class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Chargen</div>
      <div class="section-sub">Status weiter = Prozessfortschritt. Bei “Geröstet” wird Roh → Röst bewegt. Bei “Ausgeliefert” wird Röst reduziert.</div>
    </div>
    <div class="spacer"></div>
    <div class="badge info"><span class="dot"></span><%= batches.length %> Chargen</div>
  </div>

  <div class="section-body" style="padding:0;">
    <div class="table-wrap" style="border-radius:0; border-left:none; border-right:none; border-bottom:none;">
      <div class="table-head" style="grid-template-columns: 110px 1fr 120px 170px 1fr 320px;">
        <div>ID</div>
        <div>Sorte</div>
        <div class="right">kg</div>
        <div>Status</div>
        <div>Notiz</div>
        <div class="right">Aktionen</div>
      </div>

      <% if (!batches.length) { %>
        <div class="table-row" style="grid-template-columns: 1fr;">
          <div class="card" style="margin:14px;">
            <h2>Keine Chargen</h2>
            <p>Erstellen Sie oben aus dem Röstbedarf eine Charge. Danach können Sie den Status Schritt für Schritt weiterführen.</p>
            <div class="row" style="margin-top:12px;">
              <a class="btn btn-primary" href="#top"><span class="btn-icon"></span>Nach oben</a>
              <a class="btn btn-ghost" href="/orders">Bestellungen</a>
            </div>
          </div>
        </div>
      <% } %>

      <% for (var b=0; b<batches.length; b++){
          var x = batches[b];
          var sb = statusBadge(x.status);
      %>
        <div class="table-row" style="grid-template-columns: 110px 1fr 120px 170px 1fr 320px;">
          <div class="mono"><%= shortId(x.id) %></div>
          <div>
            <div style="font-weight:950;"><%= x.coffeeName %></div>
            <div class="small-note mono"><%= x.coffeeId %></div>
          </div>
          <div class="right mono"><strong><%= x.kg %></strong></div>
          <div><span class="<%= sb.cls %>"><span class="dot"></span><%= sb.label %></span></div>
          <div class="small-note"><%= x.note ? x.note : "-" %></div>

          <div class="row-actions">
            <form method="POST" action="/actions/batches/<%= x.id %>/advance">
              <button class="btn btn-sm btn-primary" type="submit">
                <span class="btn-icon" aria-hidden="true"></span>
                Status weiter
              </button>
            </form>

            <form method="POST" action="/actions/batches/<%= x.id %>/delete" onsubmit="return confirm('Charge wirklich löschen?');">
              <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
            </form>
          </div>
        </div>

        <div class="table-row" style="grid-template-columns: 1fr;">
          <div style="padding:0 14px 12px;">
            <div class="card" style="margin-top:10px;">
              <div class="row">
                <div style="font-weight:950;">Zeit</div>
                <div class="spacer"></div>
                <div class="small-note mono"><%= x.createdAt ? fmt(x.createdAt) : "-" %></div>
              </div>
              <div class="mt-3 small-note">
                <strong>Hinweis:</strong> Wenn der Status auf <strong>Geröstet</strong> geht, wird Rohkaffee reduziert und Röstkaffee erhöht.
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
