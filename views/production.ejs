<%
  var inventory = (typeof inventory !== "undefined" && inventory) ? inventory : { greenBeansKg:{}, roastedKg:{}, updatedAt:"" };
  var roastDemand = (typeof roastDemand !== "undefined" && roastDemand) ? roastDemand : [];
  var batches = (typeof batches !== "undefined" && batches) ? batches : [];

  var q = (typeof query !== "undefined" && query) ? query : {};
  // allow selection via query params if you later pass them; also supports manual URL ?batch=...
  var selectedBatchId = (q && q.batch) ? String(q.batch) : "";
  // fallback: parse from location if not passed
%>

<%
  function byId(list, id){
    id = String(id || "");
    for (var i=0;i<list.length;i++) if (String(list[i].id)===id) return list[i];
    return null;
  }
  var selectedBatch = selectedBatchId ? byId(batches, selectedBatchId) : null;

  function sumKg(map){
    var t = 0;
    for (var k in (map||{})) t += Number(map[k]||0);
    return t;
  }

  function fmtKg(n){
    n = Number(n||0);
    return (Math.round(n*10)/10).toFixed(1);
  }

  function badgeClass(st){
    if (st === "GEPLANT") return "badge";
    if (st === "GEROESTET") return "badge ok";
    if (st === "ABGEKUEHLT") return "badge";
    if (st === "VERPACKT") return "badge";
    if (st === "BEREIT") return "badge ok";
    if (st === "AUSGELIEFERT") return "badge";
    return "badge";
  }

  // build a coffee option list from demand + batches (no extra controller changes needed)
  var coffeeMap = {};
  for (var d=0; d<roastDemand.length; d++){
    coffeeMap[String(roastDemand[d].coffeeId)] = String(roastDemand[d].coffeeName || roastDemand[d].coffeeId);
  }
  for (var b=0; b<batches.length; b++){
    coffeeMap[String(batches[b].coffeeId)] = String(batches[b].coffeeName || batches[b].coffeeId);
  }
  // convert to array sorted by name
  var coffeeOptions = [];
  for (var cid in coffeeMap) coffeeOptions.push({ id: cid, name: coffeeMap[cid] });
  coffeeOptions.sort(function(a,b){ return a.name.localeCompare(b.name); });

  // inventory lists
  var greenTotal = sumKg(inventory.greenBeansKg);
  var roastedTotal = sumKg(inventory.roastedKg);

  // demand totals
  var demandTotal = 0;
  for (var x=0;x<roastDemand.length;x++) demandTotal += Number(roastDemand[x].kg || 0);

%>

<div class="card-grid" style="grid-template-columns: 420px 1fr; align-items:start;">

  <!-- LEFT PANEL -->
  <div class="card">
    <h2>Produktion</h2>
    <p class="small-note">Bedarf aus freigegebenen Bestellungen, Chargen planen und Status weiterführen.</p>

    <div class="card mt-3">
      <div class="row" style="justify-content:space-between;">
        <div>
          <div class="small-note">Inventar (Snapshot)</div>
          <div style="font-weight:950;">Rohkaffee: <span class="mono"><%= fmtKg(greenTotal) %> kg</span> · Röstkaffee: <span class="mono"><%= fmtKg(roastedTotal) %> kg</span></div>
        </div>
        <span class="badge ok"><span class="dot"></span>Live</span>
      </div>
      <div class="small-note mt-2">Update: <span class="mono"><%= (inventory.updatedAt || "").slice(0,19).replace("T"," ") %></span></div>
    </div>

    <div class="card mt-3">
      <div class="row" style="justify-content:space-between;">
        <div>
          <h2 style="margin:0;">Roast Demand</h2>
          <div class="small-note">Summe: <span class="mono"><%= fmtKg(demandTotal) %> kg</span></div>
        </div>
        <a class="btn btn-sm btn-ghost" href="#createBatch">Charge anlegen</a>
      </div>

      <div class="table-wrap mt-3">
        <div class="table-head" style="grid-template-columns: 1fr 140px 120px;">
          <div>Sorte</div>
          <div class="right">Bedarf (kg)</div>
          <div class="right">Aktion</div>
        </div>

        <% if (!roastDemand.length) { %>
          <div class="table-row" style="grid-template-columns: 1fr;">
            <div class="small-note">Kein Bedarf (noch nichts freigegeben / in Produktion).</div>
          </div>
        <% } %>

        <% for (var i=0;i<roastDemand.length;i++) { 
             var d = roastDemand[i];
             var green = Number(inventory.greenBeansKg[d.coffeeId] || 0);
             var roasted = Number(inventory.roastedKg[d.coffeeId] || 0);
        %>
          <div class="table-row" style="grid-template-columns: 1fr 140px 120px;">
            <div style="font-weight:950;">
              <%= d.coffeeName %>
              <div class="small-note mono"><%= d.coffeeId %> · Roh <%= fmtKg(green) %> · Röst <%= fmtKg(roasted) %></div>
            </div>
            <div class="right mono"><%= fmtKg(d.kg) %></div>
            <div class="right">
              <button class="btn btn-sm btn-ghost" type="button"
                onclick="prefillBatch('<%= String(d.coffeeId).replace(/'/g,'') %>','<%= String(d.coffeeName).replace(/'/g,'') %>','<%= fmtKg(d.kg) %>')">
                Planen
              </button>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="row" style="justify-content:space-between;">
        <div>
          <h2 style="margin:0;">Chargen</h2>
          <div class="small-note">Klicken zum Öffnen. Neueste oben.</div>
        </div>
      </div>

      <div class="mt-3" style="display:grid; gap:8px;">
        <% if (!batches.length) { %>
          <div class="small-note">Noch keine Chargen.</div>
        <% } %>

        <% for (var b=0;b<batches.length;b++) { 
             var it = batches[b];
             var isSel = selectedBatch && String(selectedBatch.id)===String(it.id);
        %>
          <a class="nav-item <%= isSel ? 'active' : '' %>"
             style="text-decoration:none;"
             href="/production?batch=<%= encodeURIComponent(it.id) %>">
            <div style="display:flex; flex-direction:column; gap:6px; width:100%;">
              <div class="row" style="justify-content:space-between;">
                <div style="font-weight:950;"><%= it.coffeeName %></div>
                <span class="<%= badgeClass(it.status) %>"><span class="dot"></span><%= it.status %></span>
              </div>
              <div class="small-note mono"><%= fmtKg(it.kg) %> kg · <%= it.id %></div>
            </div>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="card">
    <h2>Batch Editor</h2>
    <p class="small-note">Eine Charge bewegt Bestände: bei “GEROESTET” wird Rohkaffee → Röstkaffee gebucht.</p>

    <!-- Create -->
    <div id="createBatch" class="card mt-3">
      <h2>Neue Charge</h2>
      <form method="POST" action="/actions/batches/create" class="mt-3">
        <div style="display:grid; gap:10px;">
          <div class="row" style="gap:10px;">
            <select class="select" id="coffeePick" style="flex:1;" onchange="syncCoffeeFromPick()">
              <option value="">Sorte wählen</option>
              <% for (var c=0;c<coffeeOptions.length;c++) { %>
                <option value="<%= coffeeOptions[c].id %>"><%= coffeeOptions[c].name %> (<%= coffeeOptions[c].id %>)</option>
              <% } %>
            </select>

            <input class="input" id="kg" name="kg" placeholder="kg" style="width:140px;" />
          </div>

          <input class="input" id="coffeeId" name="coffeeId" placeholder="coffeeId (z.B. ESPRESSO)" />
          <input class="input" id="coffeeName" name="coffeeName" placeholder="coffeeName (z.B. Espresso Blend)" />

          <div class="row" style="gap:10px;">
            <select class="select" name="status" style="flex:1;">
              <option value="GEPLANT">GEPLANT</option>
              <option value="GEROESTET">GEROESTET</option>
              <option value="ABGEKUEHLT">ABGEKUEHLT</option>
              <option value="VERPACKT">VERPACKT</option>
              <option value="BEREIT">BEREIT</option>
              <option value="AUSGELIEFERT">AUSGELIEFERT</option>
            </select>
            <input class="input" name="note" placeholder="Notiz (optional)" style="flex:1;" />
          </div>

          <button class="btn btn-primary" type="submit">Charge erstellen</button>

          <div class="small-note">
            Pro Tipp: “Planen” im Bedarf setzt Sorte und kg automatisch.
          </div>
        </div>
      </form>
    </div>

    <!-- Selected batch -->
    <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
      <h2>Ausgewählte Charge</h2>

      <% if (!selectedBatch) { %>
        <div class="small-note">Wähle links eine Charge aus, um sie zu steuern.</div>
      <% } else { %>
        <div class="card mt-3">
          <div class="row" style="justify-content:space-between;">
            <div>
              <div style="font-weight:950;"><%= selectedBatch.coffeeName %></div>
              <div class="small-note mono"><%= selectedBatch.coffeeId %> · <%= fmtKg(selectedBatch.kg) %> kg</div>
            </div>
            <span class="<%= badgeClass(selectedBatch.status) %>"><span class="dot"></span><%= selectedBatch.status %></span>
          </div>

          <% if (selectedBatch.note) { %>
            <div class="small-note mt-2">Notiz: <%= selectedBatch.note %></div>
          <% } %>

          <div class="small-note mt-2">Erstellt: <span class="mono"><%= (selectedBatch.createdAt || "").slice(0,19).replace("T"," ") %></span></div>

          <div class="row mt-3" style="gap:10px; flex-wrap:wrap;">
            <form method="POST" action="/actions/batches/<%= selectedBatch.id %>/advance">
              <button class="btn btn-primary" type="submit">Nächster Status</button>
            </form>

            <form method="POST" action="/actions/batches/<%= selectedBatch.id %>/delete"
                  onsubmit="return confirm('Charge wirklich löschen?');">
              <button class="btn btn-danger" type="submit">Löschen</button>
            </form>

            <a class="btn btn-ghost" href="/production">Auswahl löschen</a>
          </div>

          <div class="card mt-3">
            <h2>Inventar Check</h2>
            <div class="small-note">
              Rohkaffee (<span class="mono"><%= selectedBatch.coffeeId %></span>):
              <span class="mono"><%= fmtKg(inventory.greenBeansKg[selectedBatch.coffeeId] || 0) %> kg</span><br/>
              Röstkaffee (<span class="mono"><%= selectedBatch.coffeeId %></span>):
              <span class="mono"><%= fmtKg(inventory.roastedKg[selectedBatch.coffeeId] || 0) %> kg</span>
            </div>
            <div class="small-note mt-2">
              Bei “GEROESTET” wird Rohkaffee um <span class="mono"><%= fmtKg(selectedBatch.kg) %></span> reduziert
              und Röstkaffee um <span class="mono"><%= fmtKg(selectedBatch.kg) %></span> erhöht.
            </div>
          </div>
        </div>
      <% } %>
    </div>

    <div class="small-note mt-3">
      Seitenhinweis: Freigegebene Bestellungen erzeugen Bedarf. Chargen bewegen Lager. Auslieferung reduziert Röstkaffee.
    </div>
  </div>

</div>

<script>
  function prefillBatch(coffeeId, coffeeName, kg){
    const pick = document.getElementById("coffeePick");
    const id = document.getElementById("coffeeId");
    const name = document.getElementById("coffeeName");
    const kgInput = document.getElementById("kg");
    if (pick) pick.value = coffeeId || "";
    if (id) id.value = coffeeId || "";
    if (name) name.value = coffeeName || "";
    if (kgInput) kgInput.value = kg || "";
    location.hash = "#createBatch";
  }

  function syncCoffeeFromPick(){
    const pick = document.getElementById("coffeePick");
    const id = document.getElementById("coffeeId");
    const name = document.getElementById("coffeeName");
    if (!pick || !id || !name) return;
    const val = pick.value || "";
    id.value = val;

    const txt = pick.options[pick.selectedIndex] ? pick.options[pick.selectedIndex].textContent : "";
    // "Name (ID)" -> Name
    const m = txt.match(/^(.*)\s+\([^)]+\)\s*$/);
    name.value = m ? m[1] : (txt || val);
  }
</script>
