<%
  var inventory = (typeof inventory !== "undefined" && inventory) ? inventory : null;
  var roastDemand = (typeof roastDemand !== "undefined" && roastDemand) ? roastDemand : [];
  var batches = (typeof batches !== "undefined" && batches) ? batches : [];

  var queryObj = (typeof query !== "undefined" && query) ? query : (typeof query !== "undefined" ? query : null);
  var roastOk = (queryObj && queryObj.roast_ok) ? String(queryObj.roast_ok) : "";
  var roastError = (queryObj && queryObj.roast_error) ? String(queryObj.roast_error) : "";
  var batchId = (queryObj && queryObj.batch_id) ? String(queryObj.batch_id) : "";

  // If your controller passes coffees, use it; otherwise fallback to inventory keys
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  if (!coffees.length && inventory && inventory.greenBeansKg) {
    coffees = Object.keys(inventory.greenBeansKg).map(id => ({ id, name: id, packDefaultKg: 1 }));
  }

  function num(v){
    var n = Number(v);
    return isFinite(n) ? n : 0;
  }
  function fmt1(n){
    var v = num(n);
    return (Math.round(v*10)/10).toFixed(1);
  }
  function fmtTs(iso){
    try { return String(iso).slice(0,19).replace("T"," "); } catch(e){ return String(iso||""); }
  }
%>

<style>
  .prod-shell{ display:grid; gap:14px; grid-template-columns:1fr; }
  @media (min-width:1100px){ .prod-shell{ grid-template-columns: 1.05fr .95fr; } }

  .notice{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.70);
    display:flex;
    gap:12px;
    align-items:flex-start;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .notice h3{ margin:0; font-size:14px; font-weight:950; }
  .notice p{ margin:6px 0 0; font-size:13px; opacity:.8; }
  .notice.ok{ border-color: rgba(38,201,122,.30); background: rgba(38,201,122,.06); }
  .notice.err{ border-color: rgba(255,77,77,.30); background: rgba(255,77,77,.06); }

  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:999px;
    border:1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.55);
    font-weight:900; font-size:12px;
    white-space:nowrap;
  }
  .pill .dot{ width:8px; height:8px; border-radius:999px; background: rgba(0,0,0,.25); }
  .pill.ok{ border-color: rgba(38,201,122,.35); background: rgba(38,201,122,.08); }
  .pill.ok .dot{ background: rgba(38,201,122,.9); }
  .pill.warn{ border-color: rgba(255,168,0,.35); background: rgba(255,168,0,.10); }
  .pill.warn .dot{ background: rgba(255,168,0,.95); }

  .kpi-grid{ display:grid; gap:10px; grid-template-columns:repeat(2, minmax(0,1fr)); }
  @media (min-width:800px){ .kpi-grid{ grid-template-columns:repeat(4, minmax(0,1fr)); } }
  .kpi{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.65);
  }
  .kpi .k{ font-size:12px; opacity:.75; font-weight:900; }
  .kpi .v{ margin-top:6px; font-weight:950; font-size:18px; }

  .panel{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:14px;
    background: rgba(255,255,255,.65);
  }
  .panel h3{ margin:0; font-weight:950; font-size:16px; }
  .panel p{ margin:8px 0 0; font-size:13px; opacity:.75; }

  .form{ margin-top:12px; display:grid; gap:10px; }
  .row2{ display:grid; grid-template-columns:1fr 170px; gap:10px; }
  .row3{ display:grid; grid-template-columns:1fr 170px 170px; gap:10px; }
  @media (max-width:800px){ .row3{ grid-template-columns:1fr; } }
  @media (max-width:700px){ .row2{ grid-template-columns:1fr; } }
  .label{ font-size:12px; opacity:.75; font-weight:900; margin-bottom:6px; }
  .inputBig{ height:46px; border-radius:16px; }

  details.fold{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.55);
  }
  details.fold summary{
    cursor:pointer;
    font-weight:950;
    list-style:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
  }
  details.fold summary::-webkit-details-marker{ display:none; }

  .list{ display:grid; gap:10px; }
  .item{
    border:1px solid rgba(0,0,0,.06);
    border-radius:16px;
    padding:12px;
    background: rgba(255,255,255,.60);
  }
  .item-top{ display:flex; justify-content:space-between; gap:10px; align-items:flex-start; flex-wrap:wrap; }
  .item-title{ font-weight:950; }
  .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  .sub{ margin-top:4px; font-size:12px; opacity:.75; }
  .actions{ display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
</style>

<% if (roastOk) { %>
  <div class="notice ok">
    <div>
      <h3>Röstung gespeichert</h3>
      <p><%= roastOk %></p>
      <% if (batchId) { %>
        <p class="mono" style="margin-top:8px; opacity:.75;">Charge-ID: <%= batchId %></p>
      <% } %>
    </div>

    <% if (batchId) { %>
      <a class="btn btn-primary" style="height:46px; border-radius:18px; display:inline-flex; align-items:center;"
         target="_blank" rel="noopener"
         href="/production/batches/<%= batchId %>/pdf">
        Röstprotokoll PDF
      </a>
    <% } %>
  </div>
<% } %>

<% if (roastError) { %>
  <div class="notice err">
    <div>
      <h3>Fehler beim Rösten</h3>
      <p><%= roastError %></p>
    </div>
  </div>
<% } %>

<div class="prod-shell">

  <!-- LEFT: Roast action + quick overview -->
  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:flex-start;">
      <div>
        <h2 style="margin:0;">Produktion</h2>
        <div class="small-note">Einfacher Ablauf: Bedarf ansehen → Rösten → PDF → Lager aktualisiert.</div>
      </div>
      <span class="pill ok"><span class="dot"></span>Admin</span>
    </div>

    <div class="kpi-grid mt-3">
      <div class="kpi">
        <div class="k">Freigegeben/Offen</div>
        <div class="v"><%= roastDemand.length %></div>
      </div>
      <div class="kpi">
        <div class="k">Chargen</div>
        <div class="v"><%= batches.length %></div>
      </div>
      <div class="kpi">
        <div class="k">Rohkaffee Sorten</div>
        <div class="v"><%= coffees.length %></div>
      </div>
      <div class="kpi">
        <div class="k">Heute</div>
        <div class="v"><span class="mono"><%= fmtTs(new Date().toISOString()) %></span></div>
      </div>
    </div>

    <div class="panel mt-3">
      <h3>Rösten (Roh → Röst)</h3>
      <p>3 Felder. Default Yield ist 85%. Lager wird automatisch aktualisiert und ein PDF wird druckbar.</p>

      <form class="form" method="POST" action="/actions/roast/create">
        <div class="row3">
          <div>
            <div class="label">Sorte</div>
            <select class="select inputBig" name="coffeeId" id="coffeeId" required>
              <option value="">Bitte wählen</option>
              <% for (var i=0;i<coffees.length;i++) { %>
                <option value="<%= coffees[i].id %>"><%= coffees[i].name %> (<%= coffees[i].id %>)</option>
              <% } %>
            </select>
            <div class="small-note" id="stockHint" style="margin-top:6px; opacity:.75;"></div>
          </div>

          <div>
            <div class="label">Roh kg</div>
            <input class="input inputBig" name="greenKg" id="greenKg" type="number" step="0.1" min="0" placeholder="z.B. 20" required />
          </div>

          <div>
            <div class="label">Yield %</div>
            <input class="input inputBig" name="yieldPct" id="yieldPct" type="number" step="1" min="50" max="100" value="85" required />
          </div>
        </div>

        <div class="row2">
          <div>
            <div class="label">Notiz (optional)</div>
            <input class="input inputBig" name="note" placeholder="z.B. Profil / Röster / Besonderheiten" />
          </div>

          <div>
            <div class="label">Erwartet (Röst kg)</div>
            <input class="input inputBig" id="expectedRoasted" type="text" value="-" readonly />
          </div>
        </div>

        <button class="btn btn-primary" type="submit" style="height:46px; border-radius:18px;">Röstung speichern</button>

        <div class="small-note" style="margin-top:8px;">
          Hinweis: Wenn nicht genug Rohkaffee vorhanden ist, blockiert das System die Röstung.
        </div>
      </form>
    </div>

    <details class="fold mt-3" open>
      <summary>
        <span>Bedarf (aus freigegebenen Bestellungen)</span>
        <span style="opacity:.6;">▼</span>
      </summary>

      <div class="list mt-3">
        <% if (!roastDemand.length) { %>
          <div class="small-note">Kein aktueller Bedarf (Freigabe fehlt oder alles erledigt).</div>
        <% } %>

        <% for (var d=0; d<roastDemand.length; d++) { %>
          <div class="item">
            <div class="item-top">
              <div>
                <div class="item-title"><%= roastDemand[d].coffeeName %></div>
                <div class="sub mono"><%= roastDemand[d].coffeeId %></div>
              </div>
              <span class="pill warn"><span class="dot"></span>Bedarf: <span class="mono"><%= fmt1(roastDemand[d].kg) %></span> kg</span>
            </div>
            <div class="small-note" style="margin-top:8px;">
              Tipp: Röste in sinnvollen Chargen (z.B. 5–15kg), statt alles auf einmal.
            </div>
          </div>
        <% } %>
      </div>
    </details>
  </div>

  <!-- RIGHT: Recent batches + quick PDF access -->
  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:flex-start;">
      <div>
        <h2 style="margin:0;">Chargen</h2>
        <div class="small-note">Letzte Röstungen. PDF jederzeit druckbar.</div>
      </div>
      <span class="pill"><span class="dot"></span><%= batches.length %> total</span>
    </div>

    <div class="list mt-3">
      <% if (!batches.length) { %>
        <div class="small-note">Noch keine Chargen vorhanden.</div>
      <% } %>

      <% for (var b=0;b<batches.length;b++) { %>
        <div class="item">
          <div class="item-top">
            <div>
              <div class="item-title"><%= batches[b].coffeeName %></div>
              <div class="sub mono"><%= batches[b].coffeeId %> · <%= fmtTs(batches[b].createdAt) %></div>
            </div>

            <span class="pill ok"><span class="dot"></span><span class="mono"><%= fmt1(batches[b].kg) %></span> kg</span>
          </div>

          <% if (batches[b].note) { %>
            <div class="small-note" style="margin-top:8px;"><%= batches[b].note %></div>
          <% } %>

          <div class="actions mt-3">
            <a class="btn btn-ghost" style="height:46px; border-radius:18px; display:inline-flex; align-items:center;"
               target="_blank" rel="noopener"
               href="/production/batches/<%= batches[b].id %>/pdf">
              PDF
            </a>
          </div>

          <div class="small-note mono" style="opacity:.6; margin-top:10px;"><%= batches[b].id %></div>
        </div>
      <% } %>
    </div>
  </div>

</div>

<script>
  const inv = <%- JSON.stringify(inventory || {}) %>;
  const coffees = <%- JSON.stringify(coffees || []) %>;

  const coffeeSel = document.getElementById("coffeeId");
  const greenKg = document.getElementById("greenKg");
  const yieldPct = document.getElementById("yieldPct");
  const expected = document.getElementById("expectedRoasted");
  const hint = document.getElementById("stockHint");

  function n(v){
    const x = Number(v);
    return Number.isFinite(x) ? x : 0;
  }
  function f1(x){
    return (Math.round(n(x)*10)/10).toFixed(1);
  }

  function updateExpected(){
    const g = n(greenKg?.value);
    const y = n(yieldPct?.value) || 85;
    const r = (g * y) / 100;
    if (expected) expected.value = (g > 0 ? (f1(r) + " kg") : "-");
  }

  function updateHint(){
    const id = coffeeSel?.value || "";
    if (!id || !hint) { if (hint) hint.textContent = ""; return; }
    const green = n(inv.greenBeansKg && inv.greenBeansKg[id]);
    const roasted = n(inv.roastedKg && inv.roastedKg[id]);

    hint.textContent = `Aktuell: Roh ${f1(green)} kg · Röst ${f1(roasted)} kg`;
  }

  if (coffeeSel) coffeeSel.addEventListener("change", () => { updateHint(); });
  if (greenKg) greenKg.addEventListener("input", updateExpected);
  if (yieldPct) yieldPct.addEventListener("input", updateExpected);

  updateHint();
  updateExpected();
</script>
