<%
  var items = (typeof activity !== "undefined" && activity) ? activity : [];
  var f = (typeof filters !== "undefined" && filters) ? filters : { search:"", area:"ALL", range:"7" };

  function fmt(at){
    if (!at) return "-";
    return String(at).slice(0,19).replace("T"," ");
  }

  function shortId(id){
    if (!id) return "-";
    var s = String(id);
    return s.length >= 8 ? s.slice(0,8) : s;
  }

  function badgeFor(action){
    var a = String(action || "");
    if (a.startsWith("ORDER")) return { cls:"badge info", label:"Bestellung" };
    if (a.startsWith("BATCH")) return { cls:"badge warn", label:"Charge" };
    if (a.startsWith("INVENTORY")) return { cls:"badge ok", label:"Lager" };
    return { cls:"badge", label:"System" };
  }

  function actionLabel(action){
    var a = String(action || "");
    var map = {
      "ORDER_CREATE": "Bestellung erstellt",
      "ORDER_STATUS": "Bestellung Status geändert",
      "ORDER_DELETE": "Bestellung gelöscht",
      "ORDER_DELIVER": "Bestellung ausgeliefert",

      "BATCH_CREATE": "Charge angelegt",
      "BATCH_STATUS": "Charge Status geändert",
      "BATCH_DELETE": "Charge gelöscht",

      "INVENTORY_CHANGE": "Bestand geändert",
      "INVENTORY_MOVE": "Lagerbewegung"
    };
    return map[a] || a || "-";
  }

  function metaPrimary(meta){
    if (!meta) return "-";
    if (meta.orderId) return "Bestellung " + shortId(meta.orderId);
    if (meta.batchId) return "Charge " + shortId(meta.batchId);
    if (meta.coffeeId) return "Sorte " + meta.coffeeId;
    return "-";
  }

  function metaDetails(meta){
    if (!meta) return [];
    var lines = [];

    if (meta.from && meta.to) lines.push("von " + meta.from + " → " + meta.to);
    if (meta.type && meta.deltaKg !== undefined) lines.push("Änderung: " + meta.type + " " + meta.deltaKg + " kg");
    else if (meta.deltaKg !== undefined) lines.push("Änderung: " + meta.deltaKg + " kg");

    if (meta.kg !== undefined) lines.push("Menge: " + meta.kg + " kg");
    if (meta.channel) lines.push("Kanal: " + meta.channel);
    if (meta.deliveryDate) lines.push("Lieferdatum: " + meta.deliveryDate);
    if (meta.note) lines.push("Notiz: " + meta.note);

    if (meta.from && meta.to && meta.coffeeId && meta.kg !== undefined) {
      // already covered, keep tidy
    }

    return lines;
  }

  function countArea(area){
    if (!items.length) return 0;
    var c = 0;
    for (var i=0;i<items.length;i++){
      var a = String(items[i].action || "");
      if (area === "ORDERS" && a.startsWith("ORDER")) c++;
      else if (area === "BATCHES" && a.startsWith("BATCH")) c++;
      else if (area === "INVENTORY" && a.startsWith("INVENTORY")) c++;
    }
    return c;
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Aktivität</h2>
    <p>Audit Log aller Aktionen: Bestellungen, Chargen und Lager. Perfekt zum Debuggen und für klare Verantwortlichkeit.</p>
  </div>

  <div class="card">
    <h2>Übersicht</h2>
    <p>
      Einträge: <strong><%= items.length %></strong><br/>
      Bestellungen: <strong><%= countArea("ORDERS") %></strong> ·
      Chargen: <strong><%= countArea("BATCHES") %></strong> ·
      Lager: <strong><%= countArea("INVENTORY") %></strong>
    </p>
  </div>
</div>

<div class="filterbar">
  <form method="GET" action="/activity" class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
    <input class="input" name="q" value="<%= f.search %>" placeholder="Suche (ID, Sorte, Aktion, Notiz)" style="min-width:260px;" />

    <select class="select" name="area">
      <option value="ALL" <%= (f.area==="ALL"?"selected":"") %>>Bereich: Alle</option>
      <option value="ORDERS" <%= (f.area==="ORDERS"?"selected":"") %>>Bestellungen</option>
      <option value="BATCHES" <%= (f.area==="BATCHES"?"selected":"") %>>Chargen</option>
      <option value="INVENTORY" <%= (f.area==="INVENTORY"?"selected":"") %>>Lager</option>
    </select>

    <select class="select" name="range">
      <option value="1" <%= (String(f.range)==="1"?"selected":"") %>>Zeitraum: Heute</option>
      <option value="7" <%= (String(f.range)==="7"?"selected":"") %>>7 Tage</option>
      <option value="30" <%= (String(f.range)==="30"?"selected":"") %>>30 Tage</option>
      <option value="90" <%= (String(f.range)==="90"?"selected":"") %>>90 Tage</option>
    </select>

    <button class="btn btn-sm" type="submit">Filtern</button>
    <a class="btn btn-sm btn-ghost" href="/activity">Reset</a>
  </form>

  <div class="filter-right">
    <a class="btn btn-sm btn-ghost" href="/orders">Bestellungen</a>
    <a class="btn btn-sm btn-ghost" href="/production">Produktion</a>
    <a class="btn btn-sm btn-ghost" href="/inventory">Lager</a>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Audit Log</div>
      <div class="section-sub">Klicken Sie sich über IDs schnell zu den betroffenen Bereichen durch (Bestellungen, Lager, Produktion).</div>
    </div>
    <div class="spacer"></div>
    <div class="badge info"><span class="dot"></span><%= items.length %> Treffer</div>
  </div>

  <div class="section-body" style="padding:0;">
    <div class="table-wrap" style="border-radius:0; border-left:none; border-right:none; border-bottom:none;">
      <div class="table-head" style="grid-template-columns: 180px 150px 1fr 1fr 180px;">
        <div>Zeit</div>
        <div>Bereich</div>
        <div>Aktion</div>
        <div>Referenz Details</div>
        <div>Status</div>
      </div>

      <% if (!items.length) { %>
        <div class="table-row" style="grid-template-columns: 1fr;">
          <div class="card" style="margin:14px;">
            <h2>Keine Einträge</h2>
            <p>Mit den aktuellen Filtern gibt es keine Aktivität. Versuchen Sie einen größeren Zeitraum oder entfernen Sie den Bereich-Filter.</p>
            <div class="row" style="margin-top:12px;">
              <a class="btn btn-primary" href="/activity"><span class="btn-icon"></span>Filter zurücksetzen</a>
              <a class="btn btn-ghost" href="/orders">Zu Bestellungen</a>
            </div>
          </div>
        </div>
      <% } %>

      <% for (var i=0; i<items.length; i++){
          var a = items[i];
          var b = badgeFor(a.action);
          var details = metaDetails(a.meta);
      %>
        <div class="table-row" style="grid-template-columns: 180px 150px 1fr 1fr 180px;">
          <div class="mono"><%= fmt(a.at) %></div>

          <div>
            <span class="<%= b.cls %>"><span class="dot"></span><%= b.label %></span>
          </div>

          <div>
            <div style="font-weight:950;"><%= actionLabel(a.action) %></div>
            <div class="small-note mono"><%= a.action %></div>
          </div>

          <div>
            <div class="small-note"><strong><%= metaPrimary(a.meta) %></strong></div>

            <% if (details && details.length) { %>
              <div class="mt-2" style="display:grid; gap:6px;">
                <% for (var d=0; d<details.length; d++) { %>
                  <div class="small-note"><%= details[d] %></div>
                <% } %>
              </div>
            <% } else { %>
              <div class="small-note">-</div>
            <% } %>
          </div>

          <div>
            <% if (String(a.action||"").indexOf("DELETE") >= 0) { %>
              <span class="badge danger"><span class="dot"></span>Entfernt</span>
            <% } else if (String(a.action||"").indexOf("STATUS") >= 0) { %>
              <span class="badge warn"><span class="dot"></span>Status</span>
            <% } else if (String(a.action||"").indexOf("INVENTORY") >= 0) { %>
              <span class="badge ok"><span class="dot"></span>Gebucht</span>
            <% } else { %>
              <span class="badge info"><span class="dot"></span>OK</span>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
