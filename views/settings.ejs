<%
  var queryObj = (typeof query !== "undefined" && query) ? query : {};

  var tab = queryObj.tab || "coffee";
  if (tab !== "coffee" && tab !== "shop" && tab !== "users") tab = "coffee";

  var userError = queryObj.user_error || null;
  var userOk = queryObj.user_ok || null;

  var masterError = queryObj.master_error || null;
  var masterOk = queryObj.master_ok || null;

  // If pageController provides allCoffees/allShops use them, otherwise fallback to coffees/shops
  var allCoffees = (typeof allCoffees !== "undefined" && allCoffees) ? allCoffees : ((typeof coffees !== "undefined" && coffees) ? coffees : []);
  var allShops   = (typeof allShops !== "undefined" && allShops) ? allShops : ((typeof shops !== "undefined" && shops) ? shops : []);

  var shopsList = (typeof shops !== "undefined" && shops) ? shops : allShops; // for user creation dropdown

  var selectedCoffeeId = queryObj.coffee || "";
  var selectedShopId   = queryObj.shop || "";

  function findById(list, id){
    for (var i=0;i<list.length;i++) if (String(list[i].id)===String(id)) return list[i];
    return null;
  }

  var selectedCoffee = selectedCoffeeId ? findById(allCoffees, selectedCoffeeId) : null;
  var selectedShop   = selectedShopId ? findById(allShops, selectedShopId) : null;

  function link(t, extra){
    var p = [];
    p.push("tab=" + encodeURIComponent(t));
    if (extra && extra.length) p.push(extra.join("&"));
    return "/settings?" + p.join("&");
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p class="small-note">Benutzerverwaltung und Stammdaten. Klarer Editor, keine chaotischen Tabellen.</p>
  </div>
  <div class="card">
    <h2>Status</h2>
    <p class="small-note">
      Kaffeesorten: <strong><%= allCoffees.length %></strong><br/>
      Filialen: <strong><%= allShops.length %></strong>
    </p>
  </div>
</div>

<% if (masterError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Stammdaten Fehler</h2>
    <p><%= masterError %></p>
  </div>
<% } %>

<% if (masterOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Stammdaten OK</h2>
    <p><%= masterOk %></p>
  </div>
<% } %>

<% if (userError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Benutzer Fehler</h2>
    <p><%= userError %></p>
  </div>
<% } %>

<% if (userOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Benutzer OK</h2>
    <p><%= userOk %></p>
  </div>
<% } %>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Admin Center</div>
      <div class="section-sub">Wählen Sie links, bearbeiten Sie rechts. Sauber, schnell, tablet-tauglich.</div>
    </div>
  </div>

  <div class="section-body">
    <!-- Tabs (simple links, no fancy toggles) -->
    <div class="filterbar">
      <div class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm <%= tab==='users'?'btn-primary':'btn-ghost' %>" href="<%= link('users') %>">Benutzer</a>
        <a class="btn btn-sm <%= tab==='coffee'?'btn-primary':'btn-ghost' %>" href="<%= link('coffee') %>">Kaffeesorten</a>
        <a class="btn btn-sm <%= tab==='shop'?'btn-primary':'btn-ghost' %>" href="<%= link('shop') %>">Filialen</a>
      </div>
      <div class="filter-right">
        <span class="badge ok"><span class="dot"></span>Admin</span>
      </div>
    </div>

    <% if (tab === "users") { %>

      <!-- USERS -->
      <div class="card mt-3">
        <h2>Benutzer erstellen</h2>
        <p class="small-note">Filiale = Bestellen + Status. Admin = alles.</p>

        <form method="POST" action="/actions/users/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="name" placeholder="Name (z.B. City)" style="min-width:200px;" />
              <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />

              <select class="select" name="role">
                <option value="SHOP">Rolle: Filiale</option>
                <option value="ADMIN">Rolle: Admin</option>
              </select>

              <select class="select" name="shopId" style="min-width:240px;">
                <option value="">Filiale wählen (nur bei Filiale)</option>
                <% for (var i=0;i<shopsList.length;i++) { %>
                  <option value="<%= shopsList[i].id %>"><%= shopsList[i].name %></option>
                <% } %>
              </select>

              <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit">Benutzer erstellen</button>
            </div>
          </div>
        </form>

        <div class="small-note mt-3">
          Nächster Schritt: Benutzerliste + Passwort-Reset direkt hier.
        </div>
      </div>

    <% } else if (tab === "coffee") { %>

      <!-- COFFEES: clean 2-column editor -->
      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <!-- LEFT: list -->
        <div class="card">
          <h2>Kaffeesorten</h2>
          <p class="small-note">Liste links. Klick → Editor rechts.</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('coffeeList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-primary btn-sm" href="#coffeeNew">Neu anlegen</a>
            </div>
          </div>

          <div id="coffeeList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var c=0;c<allCoffees.length;c++) { var x = allCoffees[c]; %>
              <a
                class="nav-item <%= (selectedCoffee && selectedCoffee.id===x.id) ? 'active' : '' %>"
                href="<%= link('coffee', ['coffee='+encodeURIComponent(x.id)]) %>"
                data-text="<%= (x.id + ' ' + x.name).toLowerCase() %>"
                style="text-decoration:none;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;"><%= x.name %></div>
                  <div class="small-note mono"><%= x.id %> · Pack <%= x.packDefaultKg || 1 %>kg</div>
                </div>
              </a>
            <% } %>

            <% if (!allCoffees.length) { %>
              <div class="small-note">Keine Sorten vorhanden.</div>
            <% } %>
          </div>

          <div class="small-note mt-3">
            Hinweis: Wenn Löschen nicht klappt, zeigt das System oben eine Fehlermeldung (master_error).
          </div>
        </div>

        <!-- RIGHT: editor -->
        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Erstellen, bearbeiten, löschen.</p>

          <!-- New -->
          <div id="coffeeNew" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Sorte</h3>
            <form method="POST" action="/actions/masters/coffee/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. ESPRESSO)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Espresso Blend)" style="min-width:260px;" />
                  <input class="input" name="packDefaultKg" placeholder="Pack kg (z.B. 1)" style="min-width:150px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit">Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <!-- Edit -->
          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Sorte bearbeiten</h3>

            <% if (!selectedCoffee) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p class="small-note">Wählen Sie links eine Sorte aus.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/coffee/update">
                <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />

                <div class="card" style="margin:0;">
                  <div class="small-note">ID (stabil)</div>
                  <div class="mono" style="font-weight:950;"><%= selectedCoffee.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedCoffee.name %>" />

                  <div class="mt-3 small-note">Pack Standard (kg)</div>
                  <input class="input" name="packDefaultKg" value="<%= selectedCoffee.packDefaultKg || 1 %>" />

                  <div class="row mt-3" style="justify-content:space-between;">
                    <button class="btn btn-primary" type="submit">Speichern</button>
                    <a class="btn btn-ghost" href="<%= link('coffee') %>">Auswahl löschen</a>
                  </div>
                </div>
              </form>

              <div class="card mt-3" style="border-color: rgba(255,77,77,.22);">
                <h2>Danger Zone</h2>
                <p class="small-note">
                  Löschen entfernt die Sorte aus Stammdaten. Falls die Sorte in Bestellungen/Chargen genutzt wurde,
                  kann das System es blockieren (dann steht die Fehlermeldung oben).
                </p>
                <form method="POST" action="/actions/masters/coffee/delete" onsubmit="return confirm('Sorte wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />
                  <button class="btn btn-danger" type="submit">Sorte löschen</button>
                </form>
              </div>
            <% } %>
          </div>

          <div class="small-note mt-3">
            Seitenhinweis: Hier pflegen Sie die Sorten, die in Bestellungen und Produktion auswählbar sind.
          </div>
        </div>
      </div>

    <% } else { %>

      <!-- SHOPS: clean 2-column editor -->
      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <!-- LEFT -->
        <div class="card">
          <h2>Filialen</h2>
          <p class="small-note">Liste links. Klick → Editor rechts.</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('shopList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-primary btn-sm" href="#shopNew">Neu anlegen</a>
            </div>
          </div>

          <div id="shopList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var s=0;s<allShops.length;s++) { var y = allShops[s]; %>
              <a
                class="nav-item <%= (selectedShop && selectedShop.id===y.id) ? 'active' : '' %>"
                href="<%= link('shop', ['shop='+encodeURIComponent(y.id)]) %>"
                data-text="<%= (y.id + ' ' + y.name).toLowerCase() %>"
                style="text-decoration:none;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;"><%= y.name %></div>
                  <div class="small-note mono"><%= y.id %></div>
                </div>
              </a>
            <% } %>

            <% if (!allShops.length) { %>
              <div class="small-note">Keine Filialen vorhanden.</div>
            <% } %>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Erstellen, bearbeiten, löschen.</p>

          <div id="shopNew" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Filiale</h3>
            <form method="POST" action="/actions/masters/shop/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. CITY)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Bunca City)" style="min-width:300px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit">Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Filiale bearbeiten</h3>

            <% if (!selectedShop) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p class="small-note">Wählen Sie links eine Filiale aus.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/shop/update">
                <input type="hidden" name="id" value="<%= selectedShop.id %>" />

                <div class="card" style="margin:0;">
                  <div class="small-note">ID (stabil)</div>
                  <div class="mono" style="font-weight:950;"><%= selectedShop.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedShop.name %>" />

                  <div class="row mt-3" style="justify-content:space-between;">
                    <button class="btn btn-primary" type="submit">Speichern</button>
                    <a class="btn btn-ghost" href="<%= link('shop') %>">Auswahl löschen</a>
                  </div>
                </div>
              </form>

              <div class="card mt-3" style="border-color: rgba(255,77,77,.22);">
                <h2>Danger Zone</h2>
                <p class="small-note">
                  Löschen kann blockiert sein, wenn Bestellungen oder Benutzer an diese Filiale gebunden sind.
                </p>
                <form method="POST" action="/actions/masters/shop/delete" onsubmit="return confirm('Filiale wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= selectedShop.id %>" />
                  <button class="btn btn-danger" type="submit">Filiale löschen</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    <% } %>
  </div>
</div>

<script>
  function filterList(listId, q){
    q = (q || "").toLowerCase().trim();
    var el = document.getElementById(listId);
    if(!el) return;
    var kids = el.querySelectorAll("[data-text]");
    kids.forEach(function(node){
      var t = (node.getAttribute("data-text") || "");
      node.style.display = (!q || t.indexOf(q) >= 0) ? "" : "none";
    });
  }
</script>
