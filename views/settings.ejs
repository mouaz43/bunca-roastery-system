<%
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var shops   = (typeof shops !== "undefined" && shops) ? shops : [];
  var users   = (typeof users !== "undefined" && users) ? users : [];
  var b2b     = (typeof b2b !== "undefined" && b2b) ? b2b : [];

  var q = (typeof query !== "undefined" && query) ? query : (typeof query !== "undefined" ? query : {});
  var tab = (q && q.tab) ? String(q.tab) : "users";

  function qp(key){ return (q && q[key]) ? String(q[key]) : ""; }

  var userError = qp("user_error");
  var userOk    = qp("user_ok");
  var masterErr = qp("master_error");
  var masterOk  = qp("master_ok");
  var b2bErr    = qp("b2b_error");
  var b2bOk     = qp("b2b_ok");

  function esc(s){ return encodeURIComponent(String(s||"")); }

  function activeTab(t){ return tab===t ? "tab active" : "tab"; }

  function firstLetter(name){
    var s = String(name||"").trim();
    return s ? s[0].toUpperCase() : "?";
  }

  function findShopName(shopId){
    var id = String(shopId||"");
    for (var i=0;i<shops.length;i++){
      if (String(shops[i].id)===id) return shops[i].name;
    }
    return "-";
  }
%>

<style>
  .settings-shell{ display:grid; gap:14px; grid-template-columns:1fr; }
  .settings-header{
    border:1px solid rgba(0,0,0,.06);
    border-radius:22px;
    padding:16px 18px;
    background: rgba(255,255,255,.65);
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:12px;
    flex-wrap:wrap;
  }
  .settings-header h2{ margin:0; }
  .settings-header .sub{ margin-top:6px; font-size:13px; opacity:.75; }
  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:999px;
    border:1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.55);
    font-weight:900; font-size:12px;
    white-space:nowrap;
  }
  .pill .dot{ width:8px; height:8px; border-radius:999px; background: rgba(0,0,0,.25); }
  .pill.ok{ border-color: rgba(38,201,122,.35); background: rgba(38,201,122,.08); }
  .pill.ok .dot{ background: rgba(38,201,122,.9); }
  .pill.warn{ border-color: rgba(255,168,0,.35); background: rgba(255,168,0,.10); }
  .pill.warn .dot{ background: rgba(255,168,0,.95); }

  .notice{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.70);
  }
  .notice.ok{ border-color: rgba(38,201,122,.30); background: rgba(38,201,122,.06); }
  .notice.err{ border-color: rgba(255,77,77,.30); background: rgba(255,77,77,.06); }
  .notice h3{ margin:0; font-size:14px; font-weight:950; }
  .notice p{ margin:6px 0 0; font-size:13px; opacity:.8; }

  .tabs{
    border:1px solid rgba(0,0,0,.06);
    border-radius:22px;
    padding:10px;
    background: rgba(255,255,255,.55);
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  .tab{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:12px 14px;
    border-radius:16px;
    border:1px solid rgba(0,0,0,.06);
    background: rgba(255,255,255,.55);
    font-weight:950;
    text-decoration:none;
    min-width:140px;
  }
  .tab:hover{ background: rgba(255,255,255,.72); text-decoration:none; }
  .tab.active{
    background: linear-gradient(180deg, rgba(200,163,106,.22), rgba(255,255,255,.55));
    border-color: rgba(200,163,106,.35);
  }

  .two-col{ display:grid; gap:14px; grid-template-columns:1fr; }
  @media (min-width:1100px){ .two-col{ grid-template-columns: 1fr 1fr; } }

  .panel{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    padding:14px;
    background: rgba(255,255,255,.65);
  }
  .panel h3{ margin:0; font-weight:950; font-size:16px; }
  .panel .sub{ margin-top:8px; font-size:13px; opacity:.75; }

  .toolbar{ display:flex; gap:10px; flex-wrap:wrap; justify-content:space-between; align-items:center; margin-top:12px; }
  .search{ flex:1; min-width:240px; }
  .bigbtn{ height:46px; border-radius:18px; font-weight:950; }

  .list{
    margin-top:12px;
    display:grid;
    gap:10px;
  }
  .rowItem{
    border:1px solid rgba(0,0,0,.06);
    border-radius:16px;
    padding:12px;
    background: rgba(255,255,255,.60);
    display:flex;
    justify-content:space-between;
    gap:12px;
    align-items:flex-start;
    flex-wrap:wrap;
  }
  .rowItem .t{ font-weight:950; }
  .rowItem .m{ margin-top:4px; font-size:12px; opacity:.75; }
  .mono{ font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  .miniActions{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:flex-end; }
  .mini{ height:40px; border-radius:16px; }

  .editorGrid{ display:grid; gap:10px; margin-top:12px; }
  .field .label{ font-size:12px; opacity:.75; font-weight:900; margin-bottom:6px; }
  .inputBig{ height:46px; border-radius:16px; }

  .avatar{
    width:38px; height:38px; border-radius:14px;
    border:1px solid rgba(0,0,0,.06);
    background: rgba(255,255,255,.60);
    display:flex; align-items:center; justify-content:center;
    font-weight:950;
  }

  .hint{
    margin-top:14px;
    border:1px dashed rgba(0,0,0,.18);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.45);
  }
  .hint b{ font-weight:950; }
</style>

<div class="settings-shell">

  <div class="settings-header">
    <div>
      <h2>Einstellungen</h2>
      <div class="sub">Admin-Hub: Benutzer, Kaffeesorten, Filialen (B2B als nächster Schritt).</div>
    </div>
    <span class="pill ok"><span class="dot"></span>Admin</span>
  </div>

  <% if (userError || masterErr || b2bErr) { %>
    <div class="notice err">
      <h3>Fehler</h3>
      <p><%= userError || masterErr || b2bErr %></p>
    </div>
  <% } %>

  <% if (userOk || masterOk || b2bOk) { %>
    <div class="notice ok">
      <h3>OK</h3>
      <p><%= userOk || masterOk || b2bOk %></p>
    </div>
  <% } %>

  <div class="tabs">
    <a class="<%= activeTab('users') %>" href="/settings?tab=users">Benutzer</a>
    <a class="<%= activeTab('coffees') %>" href="/settings?tab=coffees">Kaffeesorten</a>
    <a class="<%= activeTab('shops') %>" href="/settings?tab=shops">Filialen</a>
    <a class="<%= activeTab('b2b') %>" href="/settings?tab=b2b">B2B Kunden</a>
  </div>

  <!-- USERS -->
  <% if (tab === "users") { %>
    <div class="two-col">
      <div class="panel">
        <h3>Benutzerliste</h3>
        <div class="sub">Bearbeitbar als nächster Schritt. Aktuell: Erstellen & Löschen über Buttons (wenn aktiviert).</div>

        <div class="toolbar">
          <input class="input inputBig search" id="uSearch" placeholder="Suche (Name / E-Mail / Rolle / Filiale)" />
          <span class="pill"><span class="dot"></span><%= users.length %> Nutzer</span>
        </div>

        <div class="list" id="uList">
          <% if (!users.length) { %>
            <div class="small-note">Noch keine Benutzer vorhanden.</div>
          <% } %>

          <% for (var i=0;i<users.length;i++) { %>
            <div class="rowItem" data-search="<%= (users[i].name+' '+users[i].email+' '+users[i].role+' '+(users[i].shopId||'')).toLowerCase() %>">
              <div style="display:flex; gap:10px; align-items:flex-start;">
                <div class="avatar"><%= firstLetter(users[i].name || users[i].email) %></div>
                <div>
                  <div class="t"><%= users[i].name || "-" %></div>
                  <div class="m mono"><%= users[i].email || "-" %></div>
                  <div class="m">
                    Rolle: <b><%= users[i].role || "-" %></b>
                    <% if (users[i].role === "SHOP") { %>
                      · Filiale: <b><%= findShopName(users[i].shopId) %></b> (<span class="mono"><%= users[i].shopId || "-" %></span>)
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="miniActions">
                <!-- optional: delete endpoint later -->
                <span class="pill"><span class="dot"></span>ID: <span class="mono"><%= users[i].id || "-" %></span></span>
              </div>
            </div>
          <% } %>
        </div>

        <div class="hint">
          <b>Seitenhinweis:</b> Admin kann hier Accounts anlegen. Filialen sehen nur Dashboard + Bestellungen.
        </div>
      </div>

      <div class="panel">
        <h3>Benutzer erstellen</h3>
        <div class="sub">Schnell und sauber. Passwörter später via Reset-Funktion verwalten.</div>

        <form method="POST" action="/actions/users/create" class="editorGrid">
          <div class="field">
            <div class="label">Name</div>
            <input class="input inputBig" name="name" placeholder="z.B. Bunca City shop 1" required />
          </div>

          <div class="field">
            <div class="label">E-Mail</div>
            <input class="input inputBig" name="email" placeholder="z.B. city@bunca.local" required />
          </div>

          <div class="field">
            <div class="label">Rolle</div>
            <select class="select inputBig" name="role" id="uRole" required>
              <option value="SHOP">Filiale</option>
              <option value="ADMIN">Admin</option>
            </select>
          </div>

          <div class="field" id="uShopWrap">
            <div class="label">Filiale (nur bei Rolle Filiale)</div>
            <select class="select inputBig" name="shopId" id="uShop">
              <option value="">Bitte wählen</option>
              <% for (var s=0;s<shops.length;s++) { %>
                <option value="<%= shops[s].id %>"><%= shops[s].name %> (<%= shops[s].id %>)</option>
              <% } %>
            </select>
          </div>

          <div class="field">
            <div class="label">Passwort</div>
            <input class="input inputBig" name="password" placeholder="mind. 8 Zeichen" required />
          </div>

          <button class="btn btn-primary bigbtn" type="submit">Benutzer erstellen</button>

          <div class="hint">
            <b>Hinweis:</b> Für Filialen bitte eine Filiale auswählen. Admin sieht alle Bereiche.
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <!-- COFFEES -->
  <% if (tab === "coffees") { %>
    <div class="two-col">
      <div class="panel">
        <h3>Kaffeesorten</h3>
        <div class="sub">ID bleibt stabil. Name und Pack können aktualisiert werden.</div>

        <div class="toolbar">
          <input class="input inputBig search" id="cSearch" placeholder="Suche (ID oder Name)" />
          <span class="pill"><span class="dot"></span><%= coffees.length %> Sorten</span>
        </div>

        <div class="list" id="cList">
          <% if (!coffees.length) { %>
            <div class="small-note">Noch keine Sorten vorhanden.</div>
          <% } %>

          <% for (var c=0;c<coffees.length;c++) { %>
            <div class="rowItem"
                 data-search="<%= (coffees[c].id+' '+coffees[c].name).toLowerCase() %>"
                 onclick="pickCoffee('<%= coffees[c].id %>','<%= (coffees[c].name||'').replace(/'/g,'&#39;') %>','<%= coffees[c].packDefaultKg || 1 %>')"
                 style="cursor:pointer;">
              <div>
                <div class="t"><%= coffees[c].name %></div>
                <div class="m mono"><%= coffees[c].id %> · Pack <%= coffees[c].packDefaultKg || 1 %> kg</div>
              </div>
              <span class="pill"><span class="dot"></span>Bearbeiten</span>
            </div>
          <% } %>
        </div>

        <div class="hint">
          <b>Seitenhinweis:</b> Änderungen wirken direkt auf Bestellungen/Produktion. Löschen ist nur möglich, wenn keine Referenzen existieren.
        </div>
      </div>

      <div class="panel">
        <h3>Editor</h3>
        <div class="sub">Links auswählen oder rechts neu anlegen.</div>

        <div class="editorGrid">
          <div class="row" style="gap:10px; flex-wrap:wrap; justify-content:space-between;">
            <span class="pill"><span class="dot"></span><span id="cMode">Neu</span></span>
            <button class="btn btn-ghost mini" type="button" onclick="resetCoffee()">Reset</button>
          </div>

          <form method="POST" action="/actions/masters/coffee/create" id="coffeeCreate" class="editorGrid">
            <div class="field">
              <div class="label">ID (einmalig)</div>
              <input class="input inputBig" name="id" id="cId" placeholder="z.B. ESPRESSO" required />
            </div>
            <div class="field">
              <div class="label">Name</div>
              <input class="input inputBig" name="name" id="cName" placeholder="z.B. Espresso Blend" required />
            </div>
            <div class="field">
              <div class="label">Pack (kg)</div>
              <input class="input inputBig" name="packDefaultKg" id="cPack" type="number" step="0.1" min="0.1" value="1" required />
            </div>
            <button class="btn btn-primary bigbtn" type="submit">Sorte anlegen</button>
          </form>

          <form method="POST" action="/actions/masters/coffee/update" id="coffeeUpdate" class="editorGrid" style="display:none;">
            <input type="hidden" name="id" id="cId2" />
            <div class="field">
              <div class="label">ID (fix)</div>
              <input class="input inputBig" id="cIdView" disabled />
            </div>
            <div class="field">
              <div class="label">Name</div>
              <input class="input inputBig" name="name" id="cName2" required />
            </div>
            <div class="field">
              <div class="label">Pack (kg)</div>
              <input class="input inputBig" name="packDefaultKg" id="cPack2" type="number" step="0.1" min="0.1" required />
            </div>

            <div class="row" style="gap:10px; flex-wrap:wrap;">
              <button class="btn btn-primary bigbtn" type="submit" style="flex:1; min-width:220px;">Änderungen speichern</button>

              <form method="POST" action="/actions/masters/coffee/delete"
                    onsubmit="return confirm('Sorte wirklich löschen? Nur möglich, wenn keine Bestellungen/Chargen existieren.');"
                    style="flex:1; min-width:220px;">
                <input type="hidden" name="id" id="cDelId" />
                <button class="btn btn-danger bigbtn" type="submit" style="width:100%;">Löschen</button>
              </form>
            </div>
          </form>

          <div class="hint">
            <b>Tipp:</b> Nutze kurze, stabile IDs (z.B. ESPRESSO, FILTER). Der Name kann jederzeit geändert werden.
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- SHOPS -->
  <% if (tab === "shops") { %>
    <div class="two-col">
      <div class="panel">
        <h3>Filialen</h3>
        <div class="sub">Filial-ID wird für Rollen und Bestellungen verwendet.</div>

        <div class="toolbar">
          <input class="input inputBig search" id="sSearch" placeholder="Suche (ID oder Name)" />
          <span class="pill"><span class="dot"></span><%= shops.length %> Filialen</span>
        </div>

        <div class="list" id="sList">
          <% if (!shops.length) { %>
            <div class="small-note">Noch keine Filialen vorhanden.</div>
          <% } %>

          <% for (var s=0;s<shops.length;s++) { %>
            <div class="rowItem"
                 data-search="<%= (shops[s].id+' '+shops[s].name).toLowerCase() %>"
                 onclick="pickShop('<%= shops[s].id %>','<%= (shops[s].name||'').replace(/'/g,'&#39;') %>')"
                 style="cursor:pointer;">
              <div>
                <div class="t"><%= shops[s].name %></div>
                <div class="m mono"><%= shops[s].id %></div>
              </div>
              <span class="pill"><span class="dot"></span>Bearbeiten</span>
            </div>
          <% } %>
        </div>

        <div class="hint">
          <b>Seitenhinweis:</b> Löschen nur möglich, wenn keine Bestellungen/Benutzer an die Filiale gebunden sind.
        </div>
      </div>

      <div class="panel">
        <h3>Editor</h3>
        <div class="sub">Links auswählen oder neu anlegen.</div>

        <div class="editorGrid">
          <div class="row" style="gap:10px; flex-wrap:wrap; justify-content:space-between;">
            <span class="pill"><span class="dot"></span><span id="sMode">Neu</span></span>
            <button class="btn btn-ghost mini" type="button" onclick="resetShop()">Reset</button>
          </div>

          <form method="POST" action="/actions/masters/shop/create" id="shopCreate" class="editorGrid">
            <div class="field">
              <div class="label">ID (einmalig)</div>
              <input class="input inputBig" name="id" id="sId" placeholder="z.B. CITY" required />
            </div>
            <div class="field">
              <div class="label">Name</div>
              <input class="input inputBig" name="name" id="sName" placeholder="z.B. Bunca City" required />
            </div>
            <button class="btn btn-primary bigbtn" type="submit">Filiale anlegen</button>
          </form>

          <form method="POST" action="/actions/masters/shop/update" id="shopUpdate" class="editorGrid" style="display:none;">
            <input type="hidden" name="id" id="sId2" />
            <div class="field">
              <div class="label">ID (fix)</div>
              <input class="input inputBig" id="sIdView" disabled />
            </div>
            <div class="field">
              <div class="label">Name</div>
              <input class="input inputBig" name="name" id="sName2" required />
            </div>

            <div class="row" style="gap:10px; flex-wrap:wrap;">
              <button class="btn btn-primary bigbtn" type="submit" style="flex:1; min-width:220px;">Änderungen speichern</button>

              <form method="POST" action="/actions/masters/shop/delete"
                    onsubmit="return confirm('Filiale wirklich löschen? Nur möglich ohne Bestellungen/Benutzer.');"
                    style="flex:1; min-width:220px;">
                <input type="hidden" name="id" id="sDelId" />
                <button class="btn btn-danger bigbtn" type="submit" style="width:100%;">Löschen</button>
              </form>
            </div>
          </form>

          <div class="hint">
            <b>Tipp:</b> IDs groß schreiben (CITY, BERGER). Der Name kann später geändert werden.
          </div>
        </div>
      </div>
    </div>
  <% } %>

  <!-- B2B -->
  <% if (tab === "b2b") { %>
    <div class="two-col">
      <div class="panel">
        <h3>B2B Kunden</h3>
        <div class="sub">UI ist bereit. Backend (Create/Update/Delete) machen wir als nächsten Schritt sauber.</div>

        <div class="toolbar">
          <input class="input inputBig search" id="bSearch" placeholder="Suche (Name)" />
          <span class="pill"><span class="dot"></span><%= b2b.length %> Kunden</span>
        </div>

        <div class="list" id="bList">
          <% if (!b2b.length) { %>
            <div class="small-note">Noch keine B2B Kunden vorhanden.</div>
          <% } %>

          <% for (var b=0;b<b2b.length;b++) { %>
            <div class="rowItem" data-search="<%= String(b2b[b].name||'').toLowerCase() %>">
              <div>
                <div class="t"><%= b2b[b].name || "-" %></div>
                <div class="m">B2B Kunde</div>
              </div>
              <span class="pill warn"><span class="dot"></span>Backend folgt</span>
            </div>
          <% } %>
        </div>

        <div class="hint">
          <b>Seitenhinweis:</b> Als nächstes implementieren wir B2B CRUD + Dropdown in Bestellungen.
        </div>
      </div>

      <div class="panel">
        <h3>B2B anlegen</h3>
        <div class="sub">Noch ohne Backend. Wir machen es im nächsten Schritt komplett (DB + Routes + UI).</div>

        <div class="editorGrid">
          <div class="field">
            <div class="label">Name</div>
            <input class="input inputBig" placeholder="z.B. Firma Muster GmbH" disabled />
          </div>
          <button class="btn btn-primary bigbtn" type="button" disabled>B2B Kunde anlegen</button>

          <div class="hint">
            <b>Next:</b> DB-Tabelle `b2b_customers`, Controller + Actions + dann im Orders-Form auswählbar.
          </div>
        </div>
      </div>
    </div>
  <% } %>

</div>

<script>
  // --- USERS: role -> shop select visibility
  const uRole = document.getElementById("uRole");
  const uShopWrap = document.getElementById("uShopWrap");
  function syncUserRole(){
    if (!uRole || !uShopWrap) return;
    uShopWrap.style.display = (uRole.value === "SHOP") ? "" : "none";
  }
  if (uRole) { uRole.addEventListener("change", syncUserRole); syncUserRole(); }

  // --- Search filter helper
  function wireSearch(inputId, listId){
    const inp = document.getElementById(inputId);
    const list = document.getElementById(listId);
    if (!inp || !list) return;

    inp.addEventListener("input", () => {
      const q = (inp.value || "").toLowerCase().trim();
      const rows = Array.from(list.querySelectorAll("[data-search]"));
      rows.forEach(r => {
        const hay = r.getAttribute("data-search") || "";
        r.style.display = (!q || hay.includes(q)) ? "" : "none";
      });
    });
  }
  wireSearch("uSearch","uList");
  wireSearch("cSearch","cList");
  wireSearch("sSearch","sList");
  wireSearch("bSearch","bList");

  // --- Coffee editor (left -> right)
  function pickCoffee(id, name, pack){
    document.getElementById("cMode").textContent = "Bearbeiten";
    document.getElementById("coffeeCreate").style.display = "none";
    document.getElementById("coffeeUpdate").style.display = "";

    document.getElementById("cId2").value = id;
    document.getElementById("cIdView").value = id;
    document.getElementById("cName2").value = name || "";
    document.getElementById("cPack2").value = pack || 1;
    document.getElementById("cDelId").value = id;

    window.scrollTo({ top: 0, behavior: "smooth" });
  }
  function resetCoffee(){
    document.getElementById("cMode").textContent = "Neu";
    document.getElementById("coffeeCreate").style.display = "";
    document.getElementById("coffeeUpdate").style.display = "none";

    const id = document.getElementById("cId");
    const nm = document.getElementById("cName");
    const pk = document.getElementById("cPack");
    if (id) id.value = "";
    if (nm) nm.value = "";
    if (pk) pk.value = 1;
  }
  window.pickCoffee = pickCoffee;
  window.resetCoffee = resetCoffee;

  // --- Shop editor (left -> right)
  function pickShop(id, name){
    document.getElementById("sMode").textContent = "Bearbeiten";
    document.getElementById("shopCreate").style.display = "none";
    document.getElementById("shopUpdate").style.display = "";

    document.getElementById("sId2").value = id;
    document.getElementById("sIdView").value = id;
    document.getElementById("sName2").value = name || "";
    document.getElementById("sDelId").value = id;

    window.scrollTo({ top: 0, behavior: "smooth" });
  }
  function resetShop(){
    document.getElementById("sMode").textContent = "Neu";
    document.getElementById("shopCreate").style.display = "";
    document.getElementById("shopUpdate").style.display = "none";

    const id = document.getElementById("sId");
    const nm = document.getElementById("sName");
    if (id) id.value = "";
    if (nm) nm.value = "";
  }
  window.pickShop = pickShop;
  window.resetShop = resetShop;
</script>
