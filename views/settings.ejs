<%
  var q = (typeof query !== "undefined" && query) ? query : {};
  var tab = q.tab || "users";

  var users = (typeof users !== "undefined" && users) ? users : [];
  var b2b = (typeof b2b !== "undefined" && b2b) ? b2b : [];
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var shops = (typeof shops !== "undefined" && shops) ? shops : [];

  var userOk = q.user_ok || null, userError = q.user_error || null;
  var masterOk = q.master_ok || null, masterError = q.master_error || null;
  var b2bOk = q.b2b_ok || null, b2bError = q.b2b_error || null;

  function link(t){ return "/settings?tab=" + encodeURIComponent(t); }
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p class="small-note">Alles an einem Ort: Benutzer, Stammdaten, B2B Kunden.</p>
  </div>
  <div class="card">
    <h2>Status</h2>
    <p class="small-note">Coffees: <strong><%= coffees.length %></strong> · Shops: <strong><%= shops.length %></strong> · Users: <strong><%= users.length %></strong></p>
  </div>
</div>

<% if (userError) { %><div class="card" style="border-color: rgba(255,77,77,.35);"><h2>User Fehler</h2><p><%= userError %></p></div><% } %>
<% if (userOk) { %><div class="card" style="border-color: rgba(38,201,122,.35);"><h2>User OK</h2><p><%= userOk %></p></div><% } %>

<% if (masterError) { %><div class="card" style="border-color: rgba(255,77,77,.35);"><h2>Stammdaten Fehler</h2><p><%= masterError %></p></div><% } %>
<% if (masterOk) { %><div class="card" style="border-color: rgba(38,201,122,.35);"><h2>Stammdaten OK</h2><p><%= masterOk %></p></div><% } %>

<% if (b2bError) { %><div class="card" style="border-color: rgba(255,77,77,.35);"><h2>B2B Fehler</h2><p><%= b2bError %></p></div><% } %>
<% if (b2bOk) { %><div class="card" style="border-color: rgba(38,201,122,.35);"><h2>B2B OK</h2><p><%= b2bOk %></p></div><% } %>

<div class="section">
  <div class="section-body">
    <div class="filterbar">
      <div class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm <%= tab==='users'?'btn-primary':'btn-ghost' %>" href="<%= link('users') %>">Benutzer</a>
        <a class="btn btn-sm <%= tab==='coffee'?'btn-primary':'btn-ghost' %>" href="<%= link('coffee') %>">Kaffeesorten</a>
        <a class="btn btn-sm <%= tab==='shops'?'btn-primary':'btn-ghost' %>" href="<%= link('shops') %>">Filialen</a>
        <a class="btn btn-sm <%= tab==='b2b'?'btn-primary':'btn-ghost' %>" href="<%= link('b2b') %>">B2B Kunden</a>
      </div>
    </div>

    <% if (tab === 'users') { %>

      <div class="card mt-3">
        <h2>Benutzer erstellen</h2>
        <form method="POST" action="/actions/users/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="name" placeholder="Name" style="min-width:180px;" />
              <input class="input" name="email" placeholder="E-Mail" style="min-width:240px;" />
              <select class="select" name="role">
                <option value="SHOP">SHOP</option>
                <option value="ADMIN">ADMIN</option>
              </select>
              <select class="select" name="shopId" style="min-width:220px;">
                <option value="">Filiale (nur SHOP)</option>
                <% for (var i=0;i<shops.length;i++) { %>
                  <option value="<%= shops[i].id %>"><%= shops[i].name %> (<%= shops[i].id %>)</option>
                <% } %>
              </select>
              <input class="input" name="password" placeholder="Passwort" style="min-width:180px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit">Erstellen</button>
            </div>
          </div>
        </form>
      </div>

      <div class="card mt-3">
        <h2>Benutzerliste (bearbeitbar)</h2>
        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 1fr 1fr 120px 180px 360px;">
            <div>Name</div><div>E-Mail</div><div>Rolle</div><div>Filiale</div><div class="right">Aktionen</div>
          </div>

          <% for (var u=0; u<users.length; u++) { %>
            <div class="table-row" style="grid-template-columns: 1fr 1fr 120px 180px 360px;">
              <form method="POST" action="/actions/users/update" style="display:contents;">
                <input type="hidden" name="id" value="<%= users[u].id %>" />

                <div>
                  <input class="input" name="name" value="<%= users[u].name %>" />
                </div>

                <div class="mono small-note" style="display:flex; align-items:center;">
                  <%= users[u].email %>
                </div>

                <div>
                  <select class="select" name="role">
                    <option value="ADMIN" <%= users[u].role==='ADMIN'?'selected':'' %>>ADMIN</option>
                    <option value="SHOP" <%= users[u].role==='SHOP'?'selected':'' %>>SHOP</option>
                  </select>
                </div>

                <div>
                  <select class="select" name="shopId">
                    <option value="">-</option>
                    <% for (var i2=0;i2<shops.length;i2++) { %>
                      <option value="<%= shops[i2].id %>" <%= (users[u].shopId===shops[i2].id)?'selected':'' %>>
                        <%= shops[i2].name %> (<%= shops[i2].id %>)
                      </option>
                    <% } %>
                  </select>
                </div>

                <div class="row-actions" style="justify-content:flex-end; gap:10px;">
                  <button class="btn btn-sm btn-primary" type="submit">Speichern</button>
              </form>

                  <form method="POST" action="/actions/users/reset-password" onsubmit="return confirm('Passwort zurücksetzen?');">
                    <input type="hidden" name="id" value="<%= users[u].id %>" />
                    <button class="btn btn-sm btn-ghost" type="submit">Reset</button>
                  </form>

                  <form method="POST" action="/actions/users/set-password" onsubmit="return confirm('Passwort setzen?');">
                    <input type="hidden" name="id" value="<%= users[u].id %>" />
                    <input class="input" name="password" placeholder="Neues Passwort" style="width:160px;" />
                    <button class="btn btn-sm btn-ghost" type="submit">Set</button>
                  </form>

                  <form method="POST" action="/actions/users/delete" onsubmit="return confirm('Benutzer löschen?');">
                    <input type="hidden" name="id" value="<%= users[u].id %>" />
                    <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
                  </form>
                </div>
            </div>
          <% } %>
        </div>

        <div class="small-note mt-3">
          Hinweis: Letzter Admin kann nicht gelöscht oder zur Filiale gemacht werden.
        </div>
      </div>

    <% } else { %>
      <div class="card mt-3">
        <h2>Hinweis</h2>
        <p class="small-note">Die Tabs Coffee/Shops/B2B bleiben wie bei dir aktuell. Wenn du willst, baue ich sie als Editor rechts neu (viel schöner).</p>
      </div>
    <% } %>

  </div>
</div>
