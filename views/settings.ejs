<%
  var queryObj = (typeof query !== "undefined" && query) ? query : {};
  var tab = queryObj.tab || "users";
  if (tab !== "users" && tab !== "coffee" && tab !== "shop") tab = "users";

  var userError = queryObj.user_error || null;
  var userOk = queryObj.user_ok || null;
  var masterError = queryObj.master_error || null;
  var masterOk = queryObj.master_ok || null;

  var users = (typeof users !== "undefined" && users) ? users : [];
  var allCoffees = (typeof allCoffees !== "undefined" && allCoffees) ? allCoffees : ((typeof coffees !== "undefined") ? coffees : []);
  var allShops = (typeof allShops !== "undefined" && allShops) ? allShops : ((typeof shops !== "undefined") ? shops : []);
  var shopsList = (typeof shops !== "undefined" && shops) ? shops : allShops;

  function link(t){ return "/settings?tab=" + encodeURIComponent(t); }
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p class="small-note">Benutzerverwaltung + Stammdaten. Admin-only.</p>
  </div>
  <div class="card">
    <h2>Info</h2>
    <p class="small-note">User-Reset zeigt dir ein temporäres Passwort (einmalig).</p>
  </div>
</div>

<% if (masterError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Stammdaten Fehler</h2>
    <p><%= masterError %></p>
  </div>
<% } %>
<% if (masterOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Stammdaten OK</h2>
    <p><%= masterOk %></p>
  </div>
<% } %>

<% if (userError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Benutzer Fehler</h2>
    <p><%= userError %></p>
  </div>
<% } %>
<% if (userOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Benutzer OK</h2>
    <p><%= userOk %></p>
  </div>
<% } %>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Admin Center</div>
      <div class="section-sub">Benutzer / Kaffeesorten / Filialen</div>
    </div>
  </div>

  <div class="section-body">
    <div class="filterbar">
      <div class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm <%= tab==='users'?'btn-primary':'btn-ghost' %>" href="<%= link('users') %>">Benutzer</a>
        <a class="btn btn-sm <%= tab==='coffee'?'btn-primary':'btn-ghost' %>" href="<%= link('coffee') %>">Kaffeesorten</a>
        <a class="btn btn-sm <%= tab==='shop'?'btn-primary':'btn-ghost' %>" href="<%= link('shop') %>">Filialen</a>
      </div>
      <div class="filter-right">
        <span class="badge ok"><span class="dot"></span>Admin</span>
      </div>
    </div>

    <% if (tab === 'users') { %>

      <div class="card mt-3">
        <h2>Benutzer erstellen</h2>
        <form method="POST" action="/actions/users/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="name" placeholder="Name" style="min-width:200px;" />
              <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />
              <select class="select" name="role">
                <option value="SHOP">Rolle: Filiale</option>
                <option value="ADMIN">Rolle: Admin</option>
              </select>
              <select class="select" name="shopId" style="min-width:240px;">
                <option value="">Filiale (nur bei Filiale)</option>
                <% for (var i=0;i<shopsList.length;i++) { %>
                  <option value="<%= shopsList[i].id %>"><%= shopsList[i].name %> (<%= shopsList[i].id %>)</option>
                <% } %>
              </select>
              <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit">Erstellen</button>
            </div>
          </div>
        </form>
      </div>

      <div class="card mt-3">
        <h2>Benutzerliste</h2>
        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 1fr 1fr 140px 160px 260px;">
            <div>Name</div>
            <div>E-Mail</div>
            <div>Rolle</div>
            <div>Filiale</div>
            <div class="right">Aktionen</div>
          </div>

          <% if (!users.length) { %>
            <div class="table-row" style="grid-template-columns: 1fr;">
              <div class="small-note">Keine Benutzer gefunden.</div>
            </div>
          <% } %>

          <% for (var u=0; u<users.length; u++) { %>
            <div class="table-row" style="grid-template-columns: 1fr 1fr 140px 160px 260px;">
              <div style="font-weight:950;"><%= users[u].name %></div>
              <div class="mono small-note"><%= users[u].email %></div>
              <div><span class="badge"><span class="dot"></span><%= users[u].role %></span></div>
              <div class="mono"><%= users[u].shopId || "-" %></div>

              <div class="row-actions" style="justify-content:flex-end;">
                <form method="POST" action="/actions/users/reset-password" onsubmit="return confirm('Passwort zurücksetzen?');">
                  <input type="hidden" name="id" value="<%= users[u].id %>" />
                  <button class="btn btn-sm btn-ghost" type="submit">Reset</button>
                </form>

                <form method="POST" action="/actions/users/delete" onsubmit="return confirm('Benutzer wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= users[u].id %>" />
                  <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>

        <div class="small-note mt-3">
          Reset erzeugt ein temporäres Passwort und zeigt es oben an (user_ok).
        </div>
      </div>

    <% } else if (tab === 'coffee') { %>

      <div class="card mt-3">
        <h2>Kaffeesorten</h2>
        <p class="small-note">Diese Liste zeigt alles (active + hidden). Bearbeiten im Coffee-Editor ist der nächste Schritt, wenn du willst.</p>
        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 220px 1fr 120px;">
            <div>ID</div>
            <div>Name</div>
            <div class="right">Pack</div>
          </div>
          <% for (var c=0;c<allCoffees.length;c++) { %>
            <div class="table-row" style="grid-template-columns: 220px 1fr 120px;">
              <div class="mono"><%= allCoffees[c].id %></div>
              <div style="font-weight:950;"><%= allCoffees[c].name %></div>
              <div class="right mono"><%= allCoffees[c].packDefaultKg || 1 %></div>
            </div>
          <% } %>
        </div>
      </div>

    <% } else { %>

      <div class="card mt-3">
        <h2>Filialen</h2>
        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 220px 1fr;">
            <div>ID</div>
            <div>Name</div>
          </div>
          <% for (var s=0;s<allShops.length;s++) { %>
            <div class="table-row" style="grid-template-columns: 220px 1fr;">
              <div class="mono"><%= allShops[s].id %></div>
              <div style="font-weight:950;"><%= allShops[s].name %></div>
            </div>
          <% } %>
        </div>
      </div>

    <% } %>

  </div>
</div>
