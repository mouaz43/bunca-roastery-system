<%
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var shops = (typeof shops !== "undefined" && shops) ? shops : [];

  var userError = (typeof query !== "undefined" && query && query.user_error) ? query.user_error : null;
  var userOk = (typeof query !== "undefined" && query && query.user_ok) ? query.user_ok : null;

  var masterError = (typeof query !== "undefined" && query && query.master_error) ? query.master_error : null;
  var masterOk = (typeof query !== "undefined" && query && query.master_ok) ? query.master_ok : null;
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p>Benutzerverwaltung und Stammdaten. Änderungen werden direkt in der Datenbank gespeichert.</p>
  </div>

  <div class="card">
    <h2>Status</h2>
    <p>
      Sorten: <strong><%= coffees.length %></strong><br/>
      Filialen: <strong><%= shops.length %></strong>
    </p>
  </div>
</div>

<% if (masterError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Stammdaten Fehler</h2>
    <p><%= masterError %></p>
  </div>
<% } %>

<% if (masterOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Stammdaten OK</h2>
    <p><%= masterOk %></p>
  </div>
<% } %>

<% if (userError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Benutzer Fehler</h2>
    <p><%= userError %></p>
  </div>
<% } %>

<% if (userOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Benutzer OK</h2>
    <p><%= userOk %></p>
  </div>
<% } %>

<!-- USERS -->
<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Benutzer erstellen</div>
      <div class="section-sub">Filiale: nur Bestellungen + Status. Admin: alles.</div>
    </div>
  </div>

  <div class="section-body">
    <form method="POST" action="/actions/users/create">
      <div class="filterbar">
        <div class="filter-left">
          <input class="input" name="name" placeholder="Name (z.B. City)" style="min-width:200px;" />
          <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />

          <select class="select" name="role">
            <option value="SHOP">Rolle: Filiale</option>
            <option value="ADMIN">Rolle: Admin</option>
          </select>

          <select class="select" name="shopId" style="min-width:220px;">
            <option value="">Filiale wählen (nur bei Filiale)</option>
            <% for (var i=0;i<shops.length;i++) { %>
              <option value="<%= shops[i].id %>"><%= shops[i].name %></option>
            <% } %>
          </select>

          <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
        </div>

        <div class="filter-right">
          <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Benutzer erstellen</button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- MASTER DATA -->
<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Stammdaten</div>
      <div class="section-sub">Kaffeesorten und Filialen. Änderungen wirken sofort in Bestellungen/Produktion/Lager.</div>
    </div>
  </div>

  <div class="section-body">
    <div class="card-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">

      <!-- COFFEES -->
      <div class="card">
        <h2>Kaffeesorten</h2>
        <p class="small-note">ID ist technisch (stabil). Name kann jederzeit geändert werden.</p>

        <form method="POST" action="/actions/masters/coffee/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="id" placeholder="ID (z.B. ESPRESSO)" style="min-width:170px;" />
              <input class="input" name="name" placeholder="Name (z.B. Espresso Blend)" style="min-width:220px;" />
              <input class="input" name="packDefaultKg" placeholder="Pack kg (z.B. 1)" style="min-width:140px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Hinzufügen</button>
            </div>
          </div>
        </form>

        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 170px 1fr 110px 190px;">
            <div>ID</div>
            <div>Name</div>
            <div class="right">Pack</div>
            <div class="right">Aktionen</div>
          </div>

          <% if (!coffees.length) { %>
            <div class="table-row" style="grid-template-columns: 1fr;">
              <div class="small-note">Keine Sorten vorhanden.</div>
            </div>
          <% } %>

          <% for (var c=0; c<coffees.length; c++) { %>
            <div class="table-row" style="grid-template-columns: 170px 1fr 110px 190px;">
              <div class="mono"><%= coffees[c].id %></div>

              <form method="POST" action="/actions/masters/coffee/update" style="display:contents;">
                <input type="hidden" name="id" value="<%= coffees[c].id %>" />
                <div><input class="input" name="name" value="<%= coffees[c].name %>" style="height:40px;" /></div>
                <div class="right"><input class="input" name="packDefaultKg" value="<%= coffees[c].packDefaultKg %>" style="height:40px; width:90px; text-align:right;" /></div>
                <div class="row-actions" style="justify-content:flex-end;">
                  <button class="btn btn-sm btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>
                </div>
              </form>

              <div class="row-actions" style="justify-content:flex-end;">
                <form method="POST" action="/actions/masters/coffee/delete" onsubmit="return confirm('Sorte wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= coffees[c].id %>" />
                  <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>

        <div class="small-note mt-3">Löschen nur möglich, wenn die Sorte nicht in Bestellungen/Chargen verwendet wurde.</div>
      </div>

      <!-- SHOPS -->
      <div class="card">
        <h2>Filialen</h2>
        <p class="small-note">ID ist technisch (stabil). Name kann jederzeit geändert werden.</p>

        <form method="POST" action="/actions/masters/shop/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="id" placeholder="ID (z.B. CITY)" style="min-width:170px;" />
              <input class="input" name="name" placeholder="Name (z.B. Bunca City)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Hinzufügen</button>
            </div>
          </div>
        </form>

        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 170px 1fr 190px;">
            <div>ID</div>
            <div>Name</div>
            <div class="right">Aktionen</div>
          </div>

          <% if (!shops.length) { %>
            <div class="table-row" style="grid-template-columns: 1fr;">
              <div class="small-note">Keine Filialen vorhanden.</div>
            </div>
          <% } %>

          <% for (var s=0; s<shops.length; s++) { %>
            <div class="table-row" style="grid-template-columns: 170px 1fr 190px;">
              <div class="mono"><%= shops[s].id %></div>

              <form method="POST" action="/actions/masters/shop/update" style="display:contents;">
                <input type="hidden" name="id" value="<%= shops[s].id %>" />
                <div><input class="input" name="name" value="<%= shops[s].name %>" style="height:40px;" /></div>
                <div class="row-actions" style="justify-content:flex-end;">
                  <button class="btn btn-sm btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>
                </div>
              </form>

              <div class="row-actions" style="justify-content:flex-end;">
                <form method="POST" action="/actions/masters/shop/delete" onsubmit="return confirm('Filiale wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= shops[s].id %>" />
                  <button class="btn btn-sm btn-danger" type="submit">Löschen</button>
                </form>
              </div>
            </div>
          <% } %>
        </div>

        <div class="small-note mt-3">Löschen nur möglich, wenn keine Bestellungen oder Benutzer an die Filiale gebunden sind.</div>
      </div>

    </div>
  </div>
</div>
