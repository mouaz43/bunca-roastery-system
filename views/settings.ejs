<%
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var shops = (typeof shops !== "undefined" && shops) ? shops : [];

  var queryObj = (typeof query !== "undefined" && query) ? query : {};
  var tab = queryObj.tab || "coffee";
  if (tab !== "coffee" && tab !== "shop" && tab !== "users") tab = "coffee";

  var userError = queryObj.user_error || null;
  var userOk = queryObj.user_ok || null;

  var masterError = queryObj.master_error || null;
  var masterOk = queryObj.master_ok || null;

  var coffeeSel = queryObj.coffee || "";
  var shopSel = queryObj.shop || "";

  function findCoffee(id){
    for (var i=0;i<coffees.length;i++) if (String(coffees[i].id)===String(id)) return coffees[i];
    return null;
  }
  function findShop(id){
    for (var i=0;i<shops.length;i++) if (String(shops[i].id)===String(id)) return shops[i];
    return null;
  }

  var selectedCoffee = coffeeSel ? findCoffee(coffeeSel) : null;
  var selectedShop = shopSel ? findShop(shopSel) : null;

  function tabLink(t, extra){
    var p = [];
    p.push("tab=" + encodeURIComponent(t));
    if (extra && extra.length) p.push(extra.join("&"));
    return "/settings?" + p.join("&");
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p>Stammdaten und Benutzerverwaltung. Änderungen werden direkt gespeichert und sind sofort im System aktiv.</p>
  </div>

  <div class="card">
    <h2>Status</h2>
    <p>
      Sorten: <strong><%= coffees.length %></strong><br/>
      Filialen: <strong><%= shops.length %></strong>
    </p>
  </div>
</div>

<% if (masterError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Stammdaten Fehler</h2>
    <p><%= masterError %></p>
  </div>
<% } %>

<% if (masterOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Stammdaten OK</h2>
    <p><%= masterOk %></p>
  </div>
<% } %>

<% if (userError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Benutzer Fehler</h2>
    <p><%= userError %></p>
  </div>
<% } %>

<% if (userOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Benutzer OK</h2>
    <p><%= userOk %></p>
  </div>
<% } %>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Admin Center</div>
      <div class="section-sub">Benutzer verwalten und Stammdaten sauber pflegen (tablet-friendly).</div>
    </div>
  </div>

  <div class="section-body">
    <div class="filterbar">
      <div class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm <%= tab==='users'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('users') %>">Benutzer</a>
        <a class="btn btn-sm <%= tab==='coffee'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('coffee') %>">Kaffeesorten</a>
        <a class="btn btn-sm <%= tab==='shop'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('shop') %>">Filialen</a>
      </div>
      <div class="filter-right">
        <span class="badge info"><span class="dot"></span>Nur Admin</span>
      </div>
    </div>

    <% if (tab === 'users') { %>
      <!-- USERS -->
      <div class="card mt-3">
        <h2>Benutzer erstellen</h2>
        <p class="small-note">Filiale = Bestellen + Status prüfen. Admin = alles.</p>

        <form method="POST" action="/actions/users/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="name" placeholder="Name (z.B. City)" style="min-width:200px;" />
              <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />

              <select class="select" name="role">
                <option value="SHOP">Rolle: Filiale</option>
                <option value="ADMIN">Rolle: Admin</option>
              </select>

              <select class="select" name="shopId" style="min-width:240px;">
                <option value="">Filiale wählen (nur bei Filiale)</option>
                <% for (var i=0;i<shops.length;i++) { %>
                  <option value="<%= shops[i].id %>"><%= shops[i].name %></option>
                <% } %>
              </select>

              <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
            </div>

            <div class="filter-right">
              <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Benutzer erstellen</button>
            </div>
          </div>
        </form>

        <div class="small-note mt-3">
          Nächster Schritt: Benutzerliste + Passwort-Reset direkt hier in dieser Seite.
        </div>
      </div>

    <% } else if (tab === 'coffee') { %>

      <!-- COFFEE TWO-PANEL -->
      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <div class="card">
          <h2>Kaffeesorten</h2>
          <p class="small-note">Links auswählen, rechts bearbeiten. ID bleibt stabil.</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('coffeeList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-sm btn-primary" href="<%= tabLink('coffee', []) %>#newCoffee"><span class="btn-icon"></span>Neu</a>
            </div>
          </div>

          <div id="coffeeList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var c=0;c<coffees.length;c++) { %>
              <a
                class="nav-item <%= (selectedCoffee && selectedCoffee.id===coffees[c].id) ? 'active' : '' %>"
                href="<%= tabLink('coffee', ['coffee='+encodeURIComponent(coffees[c].id)]) %>"
                data-text="<%= (coffees[c].id + ' ' + coffees[c].name).toLowerCase() %>"
                style="text-decoration:none;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;"><%= coffees[c].name %></div>
                  <div class="small-note mono"><%= coffees[c].id %> · Pack <%= coffees[c].packDefaultKg %>kg</div>
                </div>
              </a>
            <% } %>
            <% if (!coffees.length) { %>
              <div class="small-note">Keine Sorten vorhanden.</div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Änderungen speichern oder neue Sorte anlegen.</p>

          <div id="newCoffee" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Sorte</h3>
            <form method="POST" action="/actions/masters/coffee/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. ESPRESSO)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Espresso Blend)" style="min-width:260px;" />
                  <input class="input" name="packDefaultKg" placeholder="Pack kg (z.B. 1)" style="min-width:150px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Sorte bearbeiten</h3>

            <% if (!selectedCoffee) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p>Wählen Sie links eine Sorte aus, um sie zu bearbeiten.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/coffee/update">
                <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />

                <div class="card" style="margin:0;">
                  <div class="small-note">ID (nicht änderbar)</div>
                  <div class="mono" style="font-weight:950;"><%= selectedCoffee.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedCoffee.name %>" />

                  <div class="mt-3 small-note">Pack Standard (kg)</div>
                  <input class="input" name="packDefaultKg" value="<%= selectedCoffee.packDefaultKg %>" />

                  <div class="row mt-3">
                    <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>
                    <a class="btn btn-ghost" href="<%= tabLink('coffee', []) %>">Abbrechen</a>
                  </div>
                </div>
              </form>

              <div class="card mt-3" style="border-color: rgba(255,77,77,.25);">
                <h2>Danger Zone</h2>
                <p class="small-note">Löschen nur möglich, wenn die Sorte nicht in Bestellungen/Chargen verwendet wurde.</p>
                <form method="POST" action="/actions/masters/coffee/delete" onsubmit="return confirm('Sorte wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />
                  <button class="btn btn-danger" type="submit">Sorte löschen</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    <% } else { %>

      <!-- SHOP TWO-PANEL -->
      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <div class="card">
          <h2>Filialen</h2>
          <p class="small-note">Links auswählen, rechts bearbeiten.</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('shopList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-sm btn-primary" href="<%= tabLink('shop', []) %>#newShop"><span class="btn-icon"></span>Neu</a>
            </div>
          </div>

          <div id="shopList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var s=0;s<shops.length;s++) { %>
              <a
                class="nav-item <%= (selectedShop && selectedShop.id===shops[s].id) ? 'active' : '' %>"
                href="<%= tabLink('shop', ['shop='+encodeURIComponent(shops[s].id)]) %>"
                data-text="<%= (shops[s].id + ' ' + shops[s].name).toLowerCase() %>"
                style="text-decoration:none;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;"><%= shops[s].name %></div>
                  <div class="small-note mono"><%= shops[s].id %></div>
                </div>
              </a>
            <% } %>
            <% if (!shops.length) { %>
              <div class="small-note">Keine Filialen vorhanden.</div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Neue Filiale anlegen oder bestehende bearbeiten.</p>

          <div id="newShop" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Filiale</h3>
            <form method="POST" action="/actions/masters/shop/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. CITY)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Bunca City)" style="min-width:300px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Filiale bearbeiten</h3>

            <% if (!selectedShop) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p>Wählen Sie links eine Filiale aus, um sie zu bearbeiten.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/shop/update">
                <input type="hidden" name="id" value="<%= selectedShop.id %>" />

                <div class="card" style="margin:0;">
                  <div class="small-note">ID (nicht änderbar)</div>
                  <div class="mono" style="font-weight:950;"><%= selectedShop.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedShop.name %>" />

                  <div class="row mt-3">
                    <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>
                    <a class="btn btn-ghost" href="<%= tabLink('shop', []) %>">Abbrechen</a>
                  </div>
                </div>
              </form>

              <div class="card mt-3" style="border-color: rgba(255,77,77,.25);">
                <h2>Danger Zone</h2>
                <p class="small-note">Löschen nur möglich, wenn keine Bestellungen oder Benutzer an die Filiale gebunden sind.</p>
                <form method="POST" action="/actions/masters/shop/delete" onsubmit="return confirm('Filiale wirklich löschen?');">
                  <input type="hidden" name="id" value="<%= selectedShop.id %>" />
                  <button class="btn btn-danger" type="submit">Filiale löschen</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    <% } %>

  </div>
</div>

<script>
  function filterList(listId, q){
    q = (q || "").toLowerCase().trim();
    var el = document.getElementById(listId);
    if(!el) return;
    var kids = el.querySelectorAll("[data-text]");
    kids.forEach(function(node){
      var t = (node.getAttribute("data-text") || "");
      node.style.display = (!q || t.indexOf(q) >= 0) ? "" : "none";
    });
  }
</script>
