<%
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var shops = (typeof shops !== "undefined" && shops) ? shops : [];
  var userError = (typeof query !== "undefined" && query && query.user_error) ? query.user_error : null;
  var userOk = (typeof query !== "undefined" && query && query.user_ok) ? query.user_ok : null;
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p>Stammdaten, Regeln und Benutzerverwaltung. Admin erstellt Konten für Filialen.</p>
  </div>

  <div class="card">
    <h2>Status</h2>
    <p>
      Sorten: <strong><%= coffees.length %></strong><br/>
      Filialen: <strong><%= shops.length %></strong>
    </p>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Benutzer erstellen</div>
      <div class="section-sub">Erstellen Sie Filial-Accounts, damit Mitarbeiter Bestellungen anlegen und Status verfolgen können.</div>
    </div>
  </div>

  <div class="section-body">
    <% if (userError) { %>
      <div class="card" style="border-color: rgba(255,77,77,.35);">
        <h2>Fehler</h2>
        <p><%= userError %></p>
      </div>
    <% } %>

    <% if (userOk) { %>
      <div class="card" style="border-color: rgba(38,201,122,.35);">
        <h2>OK</h2>
        <p><%= userOk %></p>
      </div>
    <% } %>

    <form method="POST" action="/actions/users/create">
      <div class="filterbar">
        <div class="filter-left">
          <input class="input" name="name" placeholder="Name (z.B. City)" style="min-width:200px;" />
          <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />

          <select class="select" name="role">
            <option value="SHOP">Rolle: Filiale</option>
            <option value="ADMIN">Rolle: Admin</option>
          </select>

          <select class="select" name="shopId" style="min-width:220px;">
            <option value="">Filiale wählen (nur bei Filiale)</option>
            <% for (var i=0;i<shops.length;i++) { %>
              <option value="<%= shops[i].id %>"><%= shops[i].name %></option>
            <% } %>
          </select>

          <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
        </div>

        <div class="filter-right">
          <button class="btn btn-primary" type="submit">
            <span class="btn-icon" aria-hidden="true"></span>
            Benutzer erstellen
          </button>
        </div>
      </div>
    </form>

    <div class="card mt-4">
      <h2>Hinweis</h2>
      <p>
        Filialen sehen nur Dashboard + Bestellungen. Admin sieht alles.<br/>
        Passwörter können wir als nächsten Schritt sicherer machen (Reset-Funktion, Mindestlänge, etc.).
      </p>
    </div>
  </div>
</div>

<!-- Keep the rest of your existing settings UI below (stammdaten / roadmap etc.) -->
<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Stammdaten</div>
      <div class="section-sub">Aktuell per Seed gesetzt. Nächster Schritt: editierbar im UI mit DB-Speicherung.</div>
    </div>
  </div>

  <div class="section-body">
    <div class="card-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
      <div class="card">
        <h2>Kaffeesorten</h2>
        <p>Diese Sorten werden in Bestellungen, Lager und Produktion verwendet.</p>

        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 1fr 1fr;">
            <div>Sorte</div>
            <div>ID</div>
          </div>
          <% if (!coffees.length) { %>
            <div class="table-row" style="grid-template-columns: 1fr;">
              <div class="small-note">Keine Sorten vorhanden.</div>
            </div>
          <% } %>
          <% for (var c=0; c<coffees.length; c++) { %>
            <div class="table-row" style="grid-template-columns: 1fr 1fr;">
              <div style="font-weight:950;"><%= coffees[c].name %></div>
              <div class="mono small-note"><%= coffees[c].id %></div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="card">
        <h2>Filialen</h2>
        <p>Filialen werden für Bestellungen und Rollen verwendet.</p>

        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 1fr 1fr;">
            <div>Filiale</div>
            <div>ID</div>
          </div>
          <% if (!shops.length) { %>
            <div class="table-row" style="grid-template-columns: 1fr;">
              <div class="small-note">Keine Filialen vorhanden.</div>
            </div>
          <% } %>
          <% for (var s=0; s<shops.length; s++) { %>
            <div class="table-row" style="grid-template-columns: 1fr 1fr;">
              <div style="font-weight:950;"><%= shops[s].name %></div>
              <div class="mono small-note"><%= shops[s].id %></div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
