<%
  var queryObj = (typeof query !== "undefined" && query) ? query : {};
  var tab = queryObj.tab || "coffee";
  if (tab !== "coffee" && tab !== "shop" && tab !== "users") tab = "coffee";

  var showArchive = String(queryObj.showArchive || "0") === "1";

  var userError = queryObj.user_error || null;
  var userOk = queryObj.user_ok || null;

  var masterError = queryObj.master_error || null;
  var masterOk = queryObj.master_ok || null;

  var allCoffees = (typeof allCoffees !== "undefined" && allCoffees) ? allCoffees : [];
  var allShops = (typeof allShops !== "undefined" && allShops) ? allShops : [];

  var selectedCoffeeId = queryObj.coffee || "";
  var selectedShopId = queryObj.shop || "";

  function findById(list, id){
    for (var i=0;i<list.length;i++) if (String(list[i].id)===String(id)) return list[i];
    return null;
  }

  var selectedCoffee = selectedCoffeeId ? findById(allCoffees, selectedCoffeeId) : null;
  var selectedShop = selectedShopId ? findById(allShops, selectedShopId) : null;

  function tabLink(t, extra){
    var p = [];
    p.push("tab=" + encodeURIComponent(t));
    p.push("showArchive=" + (showArchive ? "1" : "0"));
    if (extra && extra.length) p.push(extra.join("&"));
    return "/settings?" + p.join("&");
  }
%>

<div class="card-grid">
  <div class="card">
    <h2>Einstellungen</h2>
    <p>Admin Center: Benutzer, Kaffeesorten und Filialen. Archivieren statt kaputt löschen.</p>
  </div>
  <div class="card">
    <h2>Hinweis</h2>
    <p class="small-note">
      Archivierte Elemente verschwinden aus Dropdowns, bleiben aber für Historie erhalten.
    </p>
  </div>
</div>

<% if (masterError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Stammdaten Fehler</h2>
    <p><%= masterError %></p>
  </div>
<% } %>

<% if (masterOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Stammdaten OK</h2>
    <p><%= masterOk %></p>
  </div>
<% } %>

<% if (userError) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Benutzer Fehler</h2>
    <p><%= userError %></p>
  </div>
<% } %>

<% if (userOk) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>Benutzer OK</h2>
    <p><%= userOk %></p>
  </div>
<% } %>

<div class="section">
  <div class="section-head">
    <div>
      <div class="section-title">Admin Center</div>
      <div class="section-sub">Sauber, klar, tablet-tauglich.</div>
    </div>
  </div>

  <div class="section-body">
    <div class="filterbar">
      <div class="filter-left" style="display:flex; gap:10px; flex-wrap:wrap;">
        <a class="btn btn-sm <%= tab==='users'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('users') %>">Benutzer</a>
        <a class="btn btn-sm <%= tab==='coffee'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('coffee') %>">Kaffeesorten</a>
        <a class="btn btn-sm <%= tab==='shop'?'btn-primary':'btn-ghost' %>" href="<%= tabLink('shop') %>">Filialen</a>
      </div>
      <div class="filter-right" style="display:flex; gap:10px; align-items:center;">
        <label class="small-note" style="display:flex; gap:10px; align-items:center;">
          <input type="checkbox" <%= showArchive ? "checked" : "" %>
            onchange="location.href='<%= tabLink(tab, []) %>'.replace('showArchive=<%= showArchive? '1':'0' %>','showArchive='+(this.checked?'1':'0'))" />
          Archiv anzeigen
        </label>
        <span class="badge info"><span class="dot"></span>Admin</span>
      </div>
    </div>

    <% if (tab === 'users') { %>
      <div class="card mt-3">
        <h2>Benutzer erstellen</h2>
        <p class="small-note">Filiale = Bestellen + Status. Admin = alles.</p>

        <form method="POST" action="/actions/users/create" class="mt-3">
          <div class="filterbar">
            <div class="filter-left">
              <input class="input" name="name" placeholder="Name (z.B. City)" style="min-width:200px;" />
              <input class="input" name="email" placeholder="E-Mail" style="min-width:260px;" />
              <select class="select" name="role">
                <option value="SHOP">Rolle: Filiale</option>
                <option value="ADMIN">Rolle: Admin</option>
              </select>
              <input class="input" name="shopId" placeholder="Shop ID (z.B. CITY) nur bei Filiale" style="min-width:240px;" />
              <input class="input" name="password" placeholder="Passwort" style="min-width:200px;" />
            </div>
            <div class="filter-right">
              <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Erstellen</button>
            </div>
          </div>
        </form>
      </div>

    <% } else if (tab === 'coffee') { %>

      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <div class="card">
          <h2>Kaffeesorten</h2>
          <p class="small-note">Auswählen → rechts bearbeiten. Archivierte Sorten sind ausgeblendet (optional sichtbar).</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('coffeeList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-sm btn-primary" href="#newCoffee"><span class="btn-icon"></span>Neu</a>
            </div>
          </div>

          <div id="coffeeList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var i=0;i<allCoffees.length;i++) { 
                 var x = allCoffees[i];
                 if (!showArchive && !x.isActive) continue;
            %>
              <a
                class="nav-item <%= (selectedCoffee && selectedCoffee.id===x.id) ? 'active' : '' %>"
                href="<%= tabLink('coffee', ['coffee='+encodeURIComponent(x.id)]) %>"
                data-text="<%= (x.id + ' ' + x.name).toLowerCase() %>"
                style="text-decoration:none; opacity:<%= x.isActive ? '1' : '.55' %>;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;">
                    <%= x.name %>
                    <% if (!x.isActive) { %><span class="small-note"> (archiviert)</span><% } %>
                  </div>
                  <div class="small-note mono"><%= x.id %> · Pack <%= x.packDefaultKg %>kg</div>
                </div>
              </a>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Neu anlegen oder bestehende Sorte bearbeiten.</p>

          <div id="newCoffee" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Sorte</h3>
            <form method="POST" action="/actions/masters/coffee/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. ESPRESSO)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Espresso Blend)" style="min-width:260px;" />
                  <input class="input" name="packDefaultKg" placeholder="Pack kg (z.B. 1)" style="min-width:150px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Sorte bearbeiten</h3>

            <% if (!selectedCoffee) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p>Wählen Sie links eine Sorte aus.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/coffee/update">
                <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />
                <div class="card" style="margin:0;">
                  <div class="small-note">ID</div>
                  <div class="mono" style="font-weight:950;"><%= selectedCoffee.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedCoffee.name %>" />

                  <div class="mt-3 small-note">Pack Standard (kg)</div>
                  <input class="input" name="packDefaultKg" value="<%= selectedCoffee.packDefaultKg %>" />

                  <div class="row mt-3">
                    <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>

                    <% if (selectedCoffee.isActive) { %>
                      <form method="POST" action="/actions/masters/coffee/archive" style="display:inline;" onsubmit="return confirm('Sorte archivieren?');">
                        <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />
                        <button class="btn btn-ghost" type="submit">Archivieren</button>
                      </form>
                    <% } else { %>
                      <form method="POST" action="/actions/masters/coffee/restore" style="display:inline;">
                        <input type="hidden" name="id" value="<%= selectedCoffee.id %>" />
                        <button class="btn btn-ghost" type="submit">Wiederherstellen</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </form>

              <div class="small-note mt-3">
                Archivieren entfernt die Sorte aus Dropdowns, aber Bestell-Historie bleibt korrekt.
              </div>
            <% } %>

          </div>
        </div>
      </div>

    <% } else { %>

      <div class="card-grid mt-3" style="grid-template-columns: 380px 1fr; align-items:start;">
        <div class="card">
          <h2>Filialen</h2>
          <p class="small-note">Archivieren statt löschen. Historie bleibt sauber.</p>

          <div class="filterbar mt-3">
            <div class="filter-left">
              <input class="input" placeholder="Suche (ID oder Name)" oninput="filterList('shopList', this.value)" style="min-width:260px;" />
            </div>
            <div class="filter-right">
              <a class="btn btn-sm btn-primary" href="#newShop"><span class="btn-icon"></span>Neu</a>
            </div>
          </div>

          <div id="shopList" class="mt-3" style="display:grid; gap:8px;">
            <% for (var j=0;j<allShops.length;j++) {
                 var y = allShops[j];
                 if (!showArchive && !y.isActive) continue;
            %>
              <a
                class="nav-item <%= (selectedShop && selectedShop.id===y.id) ? 'active' : '' %>"
                href="<%= tabLink('shop', ['shop='+encodeURIComponent(y.id)]) %>"
                data-text="<%= (y.id + ' ' + y.name).toLowerCase() %>"
                style="text-decoration:none; opacity:<%= y.isActive ? '1' : '.55' %>;"
              >
                <div style="display:flex; flex-direction:column;">
                  <div style="font-weight:950;">
                    <%= y.name %>
                    <% if (!y.isActive) { %><span class="small-note"> (archiviert)</span><% } %>
                  </div>
                  <div class="small-note mono"><%= y.id %></div>
                </div>
              </a>
            <% } %>
          </div>
        </div>

        <div class="card">
          <h2>Editor</h2>
          <p class="small-note">Neue Filiale anlegen oder bestehende bearbeiten.</p>

          <div id="newShop" class="mt-3">
            <h3 style="margin:0 0 10px 0;">Neue Filiale</h3>
            <form method="POST" action="/actions/masters/shop/create">
              <div class="filterbar">
                <div class="filter-left">
                  <input class="input" name="id" placeholder="ID (z.B. CITY)" style="min-width:180px;" />
                  <input class="input" name="name" placeholder="Name (z.B. Bunca City)" style="min-width:300px;" />
                </div>
                <div class="filter-right">
                  <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Anlegen</button>
                </div>
              </div>
            </form>
          </div>

          <div class="mt-4" style="border-top:1px solid rgba(0,0,0,.06); padding-top:16px;">
            <h3 style="margin:0 0 10px 0;">Filiale bearbeiten</h3>

            <% if (!selectedShop) { %>
              <div class="card">
                <h2>Keine Auswahl</h2>
                <p>Wählen Sie links eine Filiale aus.</p>
              </div>
            <% } else { %>
              <form method="POST" action="/actions/masters/shop/update">
                <input type="hidden" name="id" value="<%= selectedShop.id %>" />
                <div class="card" style="margin:0;">
                  <div class="small-note">ID</div>
                  <div class="mono" style="font-weight:950;"><%= selectedShop.id %></div>

                  <div class="mt-3 small-note">Name</div>
                  <input class="input" name="name" value="<%= selectedShop.name %>" />

                  <div class="row mt-3">
                    <button class="btn btn-primary" type="submit"><span class="btn-icon"></span>Speichern</button>

                    <% if (selectedShop.isActive) { %>
                      <form method="POST" action="/actions/masters/shop/archive" style="display:inline;" onsubmit="return confirm('Filiale archivieren?');">
                        <input type="hidden" name="id" value="<%= selectedShop.id %>" />
                        <button class="btn btn-ghost" type="submit">Archivieren</button>
                      </form>
                    <% } else { %>
                      <form method="POST" action="/actions/masters/shop/restore" style="display:inline;">
                        <input type="hidden" name="id" value="<%= selectedShop.id %>" />
                        <button class="btn btn-ghost" type="submit">Wiederherstellen</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </form>
            <% } %>
          </div>
        </div>
      </div>

    <% } %>

  </div>
</div>

<script>
  function filterList(listId, q){
    q = (q || "").toLowerCase().trim();
    var el = document.getElementById(listId);
    if(!el) return;
    var kids = el.querySelectorAll("[data-text]");
    kids.forEach(function(node){
      var t = (node.getAttribute("data-text") || "");
      node.style.display = (!q || t.indexOf(q) >= 0) ? "" : "none";
    });
  }
</script>
