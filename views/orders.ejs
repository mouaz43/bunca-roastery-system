<%
  var orders = (typeof orders !== "undefined" && orders) ? orders : [];
  var selectedOrder = (typeof selectedOrder !== "undefined") ? selectedOrder : null;

  var shops = (typeof shops !== "undefined" && shops) ? shops : [];
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var b2bCustomers = (typeof b2bCustomers !== "undefined" && b2bCustomers) ? b2bCustomers : [];

  var filters = (typeof filters !== "undefined" && filters) ? filters : { search:"", status:"ALL", channel:"ALL", shop:"ALL", range:"30" };
  var okMsg = (typeof okMsg !== "undefined" && okMsg) ? okMsg : "";
  var errMsg = (typeof errMsg !== "undefined" && errMsg) ? errMsg : "";

  var shopMode = !!(typeof shopMode !== "undefined" && shopMode);
  var shopId = (typeof shopId !== "undefined" && shopId) ? shopId : "";

  function esc(s){ return encodeURIComponent(String(s||"")); }

  function buildLink(extra){
    var qs =
      "q="+esc(filters.search)+
      "&status="+esc(filters.status)+
      "&channel="+esc(filters.channel)+
      "&shop="+esc(filters.shop)+
      "&range="+esc(filters.range);
    if (extra) qs += "&" + extra;
    return "/orders?" + qs;
  }

  function statusLabel(st){
    if (st==="EINGEGANGEN") return "Eingegangen";
    if (st==="FREIGEGEBEN") return "Freigegeben";
    if (st==="IN_PRODUKTION") return "In Produktion";
    if (st==="VERPACKT") return "Verpackt";
    if (st==="AUSGELIEFERT") return "Ausgeliefert";
    return st || "-";
  }

  function badgeClass(st){
    if (st==="FREIGEGEBEN" || st==="AUSGELIEFERT") return "badge ok";
    return "badge";
  }

  function channelLabel(ch){
    return ch==="B2B" ? "B2B" : "Filiale";
  }

  function whoLabel(o){
    if (o.channel==="B2B") return (o.customerName || "B2B Kunde");
    return (o.shopId || "Filiale");
  }
%>

<style>
  .orders-grid{ display:grid; gap:14px; grid-template-columns:1fr; }
  @media (min-width:1100px){ .orders-grid{ grid-template-columns:460px 1fr; } }

  .pill{
    display:inline-flex; align-items:center; gap:8px;
    padding:10px 12px; border-radius:999px;
    border:1px solid rgba(0,0,0,.08);
    background: rgba(255,255,255,.55);
    font-weight:900; font-size:12px;
  }
  .pill .dot{ width:8px; height:8px; border-radius:999px; background: rgba(0,0,0,.25); }
  .pill.ok{ border-color: rgba(38,201,122,.35); background: rgba(38,201,122,.08); }
  .pill.ok .dot{ background: rgba(38,201,122,.9); }

  .inbox{ display:grid; gap:10px; }
  .order-card{
    border:1px solid rgba(0,0,0,.07);
    border-radius:18px;
    padding:12px;
    background: rgba(255,255,255,.6);
  }
  .order-card.active{
    border-color: rgba(200,163,106,.35);
    background: linear-gradient(180deg, rgba(200,163,106,.14), rgba(255,255,255,.55));
  }
  .order-card:hover{ text-decoration:none; }

  .collapse{
    border:1px solid rgba(0,0,0,.06);
    border-radius:18px;
    background: rgba(255,255,255,.55);
    padding:12px;
  }
  .collapse summary{
    cursor:pointer;
    font-weight:950;
    list-style:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
  }
  .collapse summary::-webkit-details-marker{ display:none; }
  .chev{ opacity:.55; font-weight:950; }

  .field{ display:grid; gap:6px; }
  .field .label{ font-size:12px; font-weight:900; opacity:.75; }
  .stack{ display:grid; gap:10px; }

  /* Fixed assortment list (shop + admin) */
  .assort-head{
    display:flex; align-items:flex-start; justify-content:space-between; gap:12px;
  }
  .assort-grid{
    display:grid; gap:10px; margin-top:12px;
  }
  .assort-row{
    display:grid;
    grid-template-columns: 1fr 160px;
    gap:10px;
    align-items:center;
    padding:10px;
    border:1px solid rgba(0,0,0,.06);
    border-radius:16px;
    background: rgba(255,255,255,.65);
  }
  @media (max-width:700px){
    .assort-row{ grid-template-columns: 1fr; }
  }
  .assort-name{ font-weight:950; }
  .assort-meta{ font-size:12px; opacity:.7; margin-top:2px; }
  .qty{
    height:46px;
    border-radius:16px;
  }

  .sticky-bar{
    position: sticky;
    bottom: 0;
    z-index: 5;
    padding-top: 12px;
    background: linear-gradient(180deg, rgba(0,0,0,0), rgba(255,255,255,.85) 35%, rgba(255,255,255,.95));
    backdrop-filter: blur(6px);
  }
  .sticky-inner{
    border:1px solid rgba(0,0,0,.06);
    border-radius:22px;
    padding:12px;
    background: rgba(255,255,255,.75);
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .primary-wide{
    min-width: 220px;
    height: 46px;
    border-radius: 18px;
    font-weight: 950;
  }
  .ghost-wide{
    height: 46px;
    border-radius: 18px;
  }
</style>

<% if (errMsg) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);">
    <h2>Fehler</h2>
    <p><%= errMsg %></p>
  </div>
<% } %>

<% if (okMsg) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);">
    <h2>OK</h2>
    <p><%= okMsg %></p>
  </div>
<% } %>

<div class="orders-grid">

  <!-- LEFT: Inbox -->
  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:flex-start;">
      <div>
        <h2 style="margin:0;">Bestellungen</h2>
        <div class="small-note">Große Karten, schnell tippen. Tablet-optimiert.</div>
      </div>
      <span class="pill <%= shopMode ? 'ok' : '' %>">
        <span class="dot"></span><%= shopMode ? ("Filiale: " + shopId) : "Admin" %>
      </span>
    </div>

    <details class="collapse mt-3" open>
      <summary>
        <span>Filter</span>
        <span class="chev">▼</span>
      </summary>

      <form method="GET" action="/orders" class="mt-3">
        <div class="stack">
          <input class="input" name="q" placeholder="Suche (ID, Kunde, Notiz, Sorte...)" value="<%= filters.search %>"/>

          <div class="row" style="gap:10px; flex-wrap:wrap;">
            <select class="select" name="status" style="flex:1; min-width:220px;">
              <option value="ALL" <%= filters.status==="ALL"?"selected":"" %>>Status: Alle</option>
              <option value="EINGEGANGEN" <%= filters.status==="EINGEGANGEN"?"selected":"" %>>Eingegangen</option>
              <option value="FREIGEGEBEN" <%= filters.status==="FREIGEGEBEN"?"selected":"" %>>Freigegeben</option>
              <option value="IN_PRODUKTION" <%= filters.status==="IN_PRODUKTION"?"selected":"" %>>In Produktion</option>
              <option value="VERPACKT" <%= filters.status==="VERPACKT"?"selected":"" %>>Verpackt</option>
              <option value="AUSGELIEFERT" <%= filters.status==="AUSGELIEFERT"?"selected":"" %>>Ausgeliefert</option>
            </select>

            <select class="select" name="range" style="min-width:200px;">
              <option value="7" <%= filters.range==="7"?"selected":"" %>>Letzte 7 Tage</option>
              <option value="30" <%= filters.range==="30"?"selected":"" %>>Letzte 30 Tage</option>
              <option value="90" <%= filters.range==="90"?"selected":"" %>>Letzte 90 Tage</option>
            </select>
          </div>

          <% if (!shopMode) { %>
            <div class="row" style="gap:10px; flex-wrap:wrap;">
              <select class="select" name="channel" style="flex:1; min-width:200px;">
                <option value="ALL" <%= filters.channel==="ALL"?"selected":"" %>>Kanal: Alle</option>
                <option value="FILIALE" <%= filters.channel==="FILIALE"?"selected":"" %>>Filiale</option>
                <option value="B2B" <%= filters.channel==="B2B"?"selected":"" %>>B2B</option>
              </select>

              <select class="select" name="shop" style="flex:1; min-width:200px;">
                <option value="ALL" <%= filters.shop==="ALL"?"selected":"" %>>Filiale: Alle</option>
                <% for (var s=0;s<shops.length;s++) { %>
                  <option value="<%= shops[s].id %>" <%= String(filters.shop)===String(shops[s].id)?"selected":"" %>><%= shops[s].name %></option>
                <% } %>
              </select>
            </div>
          <% } %>

          <button class="btn btn-primary" type="submit" style="height:46px; border-radius:18px;">Anwenden</button>
        </div>
      </form>
    </details>

    <div class="inbox mt-3">
      <% if (!orders.length) { %>
        <div class="small-note">Keine Bestellungen gefunden.</div>
      <% } %>

      <% for (var i=0;i<orders.length;i++) {
           var o = orders[i];
           var isSel = selectedOrder && String(selectedOrder.id)===String(o.id);
      %>
        <a class="order-card <%= isSel ? 'active' : '' %>" style="text-decoration:none;" href="<%= buildLink('order='+esc(o.id)) %>">
          <div class="row" style="justify-content:space-between; align-items:flex-start; gap:10px;">
            <div style="min-width:0;">
              <div style="font-weight:950; font-size:16px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                <%= whoLabel(o) %>
              </div>
              <div class="small-note">
                <span class="mono"><%= o.deliveryDate %></span> · <%= channelLabel(o.channel) %> · <span class="mono"><%= (o.items||[]).length %></span> Pos
              </div>
            </div>

            <span class="<%= badgeClass(o.status) %>" style="white-space:nowrap;">
              <span class="dot"></span><%= statusLabel(o.status) %>
            </span>
          </div>
          <div class="small-note mono" style="opacity:.65; margin-top:8px;"><%= o.id %></div>
        </a>
      <% } %>
    </div>
  </div>

  <!-- RIGHT: Create / Details -->
  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:flex-start;">
      <div>
        <h2 style="margin:0;"><%= selectedOrder ? "Bestellung Details" : "Neue Bestellung" %></h2>
        <div class="small-note">
          <%= shopMode ? "Filiale: feste Bestellliste (vom Admin). Nur Mengen eingeben." : "Admin: gleiche Bestellliste, nur Mengen eingeben." %>
        </div>
      </div>

      <% if (selectedOrder) { %>
        <span class="<%= badgeClass(selectedOrder.status) %>"><span class="dot"></span><%= statusLabel(selectedOrder.status) %></span>
      <% } else { %>
        <span class="pill ok"><span class="dot"></span>Erstellen</span>
      <% } %>
    </div>

    <% if (selectedOrder) { %>

      <!-- DETAILS -->
      <div class="card mt-3">
        <div class="row" style="justify-content:space-between; gap:10px; flex-wrap:wrap;">
          <div>
            <div class="small-note">ID</div>
            <div class="mono" style="font-weight:950;"><%= selectedOrder.id %></div>
          </div>
          <div>
            <div class="small-note">Lieferdatum</div>
            <div class="mono" style="font-weight:950;"><%= selectedOrder.deliveryDate %></div>
          </div>
        </div>

        <div class="mt-3 small-note">
          Kanal: <span class="mono"><%= selectedOrder.channel %></span> ·
          <%= selectedOrder.channel==="B2B"
                ? ("Kunde: <span class='mono'>"+(selectedOrder.customerName||"-")+"</span>")
                : ("Filiale: <span class='mono'>"+(selectedOrder.shopId||"-")+"</span>") %>
        </div>

        <% if (selectedOrder.note) { %>
          <div class="mt-2 small-note">Notiz: <%= selectedOrder.note %></div>
        <% } %>
      </div>

      <div class="card mt-3">
        <h2>Positionen</h2>
        <div class="stack mt-3">
          <% for (var k=0;k<(selectedOrder.items||[]).length;k++) { %>
            <div class="order-card">
              <div style="font-weight:950;"><%= selectedOrder.items[k].coffeeName %></div>
              <div class="small-note mono"><%= selectedOrder.items[k].coffeeId %></div>
              <div class="row mt-2" style="justify-content:space-between;">
                <div class="small-note">Menge</div>
                <div class="mono" style="font-weight:950;"><%= selectedOrder.items[k].kg %> kg</div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <div class="sticky-bar">
        <div class="sticky-inner">
          <a class="btn btn-ghost ghost-wide" href="<%= buildLink('') %>">Neue Bestellung</a>

          <!-- PDF BUTTON (Shop + Admin) -->
          <a class="btn btn-ghost ghost-wide" target="_blank" href="/orders/<%= selectedOrder.id %>/pdf">PDF drucken</a>

          <% if (!shopMode) { %>
            <div class="row" style="gap:10px; flex-wrap:wrap; justify-content:flex-end;">
              <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/approve">
                <button class="btn btn-ghost ghost-wide" type="submit">Freigeben</button>
              </form>

              <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/advance">
                <button class="btn btn-primary primary-wide" type="submit">Nächster Status</button>
              </form>

              <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/deliver"
                    onsubmit="return confirm('Ausliefern? (zieht Röstkaffee ab)');">
                <button class="btn btn-ghost ghost-wide" type="submit">Ausliefern</button>
              </form>

              <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/delete"
                    onsubmit="return confirm('Bestellung löschen?');">
                <button class="btn btn-danger ghost-wide" type="submit">Löschen</button>
              </form>
            </div>
          <% } else { %>
            <div class="small-note">Freigabe/Produktion/Auslieferung macht die Rösterei.</div>
          <% } %>
        </div>
      </div>

    <% } else { %>

      <!-- CREATE -->
      <form id="orderForm" method="POST" action="/actions/orders/create">
        <input type="hidden" name="payload" id="payload" value="" />
        <input type="hidden" id="deliveryDate" value="" />

        <div class="card mt-3">
          <h2>Details</h2>

          <div class="stack mt-3">
            <div class="field">
              <div class="label">Lieferdatum</div>
              <input class="input" id="deliveryDateUI" type="date" />
            </div>

            <% if (!shopMode) { %>
              <div class="field">
                <div class="label">Kanal</div>
                <select class="select" id="channel">
                  <option value="FILIALE">Filiale</option>
                  <option value="B2B">B2B</option>
                </select>
              </div>

              <div class="field" id="rowShop">
                <div class="label">Filiale</div>
                <select class="select" id="shopId">
                  <option value="">Bitte auswählen</option>
                  <% for (var s=0;s<shops.length;s++) { %>
                    <option value="<%= shops[s].id %>"><%= shops[s].name %> (<%= shops[s].id %>)</option>
                  <% } %>
                </select>
              </div>

              <div class="field" id="rowB2B" style="display:none;">
                <div class="label">B2B Kunde</div>
                <select class="select" id="b2bCustomer">
                  <option value="">Bitte auswählen</option>
                  <% for (var b=0;b<b2bCustomers.length;b++) { %>
                    <option value="<%= b2bCustomers[b].name %>"><%= b2bCustomers[b].name %></option>
                  <% } %>
                </select>
                <div class="small-note">Oder manuell:</div>
                <input class="input" id="customerName" placeholder="B2B Kunde (Name)" />
              </div>
            <% } else { %>
              <span class="pill ok"><span class="dot"></span>Filiale: <span class="mono"><%= shopId %></span></span>
            <% } %>

            <div class="field">
              <div class="label">Notiz (optional)</div>
              <input class="input" id="note" placeholder="z.B. bitte bis 10:00 liefern" />
            </div>
          </div>
        </div>

        <!-- FIXED ORDER LIST DROPDOWN (SHOP + ADMIN) -->
        <details class="collapse mt-3" open id="assortmentDropdown">
          <summary>
            <span>Bestellliste öffnen</span>
            <span class="chev">▼</span>
          </summary>

          <div class="assort-head mt-3">
            <div>
              <div style="font-weight:950;">Feste Sortenliste</div>
              <div class="small-note">
                Diese Liste kommt aus den Admin-Stammdaten. Es werden nur Mengen eingetragen.
              </div>
            </div>
            <span class="pill"><span class="dot"></span><span id="itemsCount">0</span> Positionen</span>
          </div>

          <div class="row mt-3" style="justify-content:space-between;">
            <div class="small-note">Summe</div>
            <div class="mono" style="font-weight:950;" id="totalKg">0.0 kg</div>
          </div>

          <div class="assort-grid" id="assortGrid">
            <% for (var c=0;c<coffees.length;c++) { %>
              <div class="assort-row">
                <div>
                  <div class="assort-name"><%= coffees[c].name %></div>
                  <div class="assort-meta mono"><%= coffees[c].id %> · Pack <%= (coffees[c].packDefaultKg || 1) %>kg</div>
                </div>
                <div class="field">
                  <div class="label">kg</div>
                  <input
                    class="input qty"
                    type="number"
                    step="0.1"
                    min="0"
                    inputmode="decimal"
                    placeholder="0"
                    data-coffee-id="<%= coffees[c].id %>"
                    data-coffee-name="<%= coffees[c].name.replace(/"/g, '&quot;') %>"
                    value="0"
                  />
                </div>
              </div>
            <% } %>
          </div>

          <div class="small-note mt-3">
            Tipp: 0 = nicht bestellen. Alles &gt; 0 wird als Position übernommen.
          </div>
        </details>

        <div class="sticky-bar">
          <div class="sticky-inner">
            <div class="small-note">Prüfen: Datum + mindestens 1 Position.</div>
            <button class="btn btn-primary primary-wide" type="submit">Bestellung erstellen</button>
          </div>
        </div>

        <div class="small-note mt-3">
          Seitenhinweis: Freigabe zählt für Produktionsbedarf. Ausliefern zieht Röstkaffee ab.
        </div>
      </form>

    <% } %>
  </div>

</div>

<script>
  const shopMode = <%- JSON.stringify(!!shopMode) %>;
  const shopId = <%- JSON.stringify(shopId || "") %>;

  function toISODate(val){
    if (!val) return "";
    if (/^\d{4}-\d{2}-\d{2}$/.test(val)) return val;

    const m = String(val).match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (m) {
      const mm = String(m[1]).padStart(2,"0");
      const dd = String(m[2]).padStart(2,"0");
      return `${m[3]}-${mm}-${dd}`;
    }
    return "";
  }

  function setDefaultDate(){
    const ui = document.getElementById("deliveryDateUI");
    const hid = document.getElementById("deliveryDate");
    if (!ui || !hid) return;

    if (!ui.value) {
      const d = new Date();
      d.setDate(d.getDate() + 1);
      const iso = d.toISOString().slice(0,10);
      ui.value = iso;
      hid.value = iso;
    } else {
      hid.value = toISODate(ui.value);
    }
  }

  function syncChannelUI(){
    const ch = document.getElementById("channel");
    const rowShop = document.getElementById("rowShop");
    const rowB2B = document.getElementById("rowB2B");
    if (!ch || !rowShop || !rowB2B) return;

    if (ch.value === "B2B") {
      rowShop.style.display = "none";
      rowB2B.style.display = "";
    } else {
      rowShop.style.display = "";
      rowB2B.style.display = "none";
    }
  }

  function fmt1(n){
    const v = Number(n||0);
    return (Math.round(v*10)/10).toFixed(1);
  }

  function computeTotals(){
    const inputs = Array.from(document.querySelectorAll("#assortGrid input.qty"));
    let count = 0;
    let total = 0;

    inputs.forEach(i => {
      const kg = Number(i.value || 0);
      if (Number.isFinite(kg) && kg > 0) {
        count += 1;
        total += kg;
      }
    });

    const c = document.getElementById("itemsCount");
    if (c) c.textContent = String(count);

    const t = document.getElementById("totalKg");
    if (t) t.textContent = fmt1(total) + " kg";
  }

  // INIT (create mode only)
  if (document.getElementById("orderForm")) {
    setDefaultDate();
    const ui = document.getElementById("deliveryDateUI");
    if (ui) ui.addEventListener("change", () => {
      const hid = document.getElementById("deliveryDate");
      if (hid) hid.value = toISODate(ui.value);
    });

    const ch = document.getElementById("channel");
    if (ch) { ch.addEventListener("change", syncChannelUI); syncChannelUI(); }

    const b2bSel = document.getElementById("b2bCustomer");
    if (b2bSel) b2bSel.addEventListener("change", () => {
      const name = document.getElementById("customerName");
      if (name && b2bSel.value) name.value = b2bSel.value;
    });

    const inputs = Array.from(document.querySelectorAll("#assortGrid input.qty"));
    inputs.forEach(i => i.addEventListener("input", computeTotals));
    computeTotals();

    document.getElementById("orderForm").addEventListener("submit", () => {
      const channel = shopMode ? "FILIALE" : (document.getElementById("channel")?.value || "FILIALE");

      const dateISO =
        document.getElementById("deliveryDate")?.value ||
        toISODate(document.getElementById("deliveryDateUI")?.value || "");

      const hid = document.getElementById("deliveryDate");
      if (hid) hid.value = dateISO;

      const note = document.getElementById("note")?.value || "";

      let payload = {
        channel,
        shopId: shopMode ? shopId : (document.getElementById("shopId")?.value || ""),
        customerName: (document.getElementById("customerName")?.value || ""),
        deliveryDate: dateISO,
        note,
        items: []
      };

      const b2b = document.getElementById("b2bCustomer");
      if (!shopMode && channel === "B2B" && b2b && b2b.value && !payload.customerName) {
        payload.customerName = b2b.value;
      }

      // Build items from fixed list (only >0 kg)
      const all = Array.from(document.querySelectorAll("#assortGrid input.qty"));
      payload.items = all
        .map(i => ({
          coffeeId: i.getAttribute("data-coffee-id"),
          coffeeName: i.getAttribute("data-coffee-name"),
          kg: Number(i.value || 0)
        }))
        .filter(it => it.coffeeId && it.coffeeName && Number.isFinite(it.kg) && it.kg > 0);

      document.getElementById("payload").value = JSON.stringify(payload);
    });
  }
</script>
