<%
  var orders = (typeof orders !== "undefined" && orders) ? orders : [];
  var selectedOrder = (typeof selectedOrder !== "undefined") ? selectedOrder : null;

  var shops = (typeof shops !== "undefined" && shops) ? shops : [];
  var coffees = (typeof coffees !== "undefined" && coffees) ? coffees : [];
  var b2bCustomers = (typeof b2bCustomers !== "undefined" && b2bCustomers) ? b2bCustomers : [];

  var filters = (typeof filters !== "undefined" && filters) ? filters : { search:"", status:"ALL", channel:"ALL", shop:"ALL", range:"30" };
  var okMsg = (typeof okMsg !== "undefined" && okMsg) ? okMsg : "";
  var errMsg = (typeof errMsg !== "undefined" && errMsg) ? errMsg : "";

  var shopMode = !!(typeof shopMode !== "undefined" && shopMode);
  var shopId = (typeof shopId !== "undefined" && shopId) ? shopId : "";
  var user = (typeof user !== "undefined" && user) ? user : null;

  function esc(s){ return encodeURIComponent(String(s||"")); }
  function buildLink(extra){
    var qs = "tab=orders"; // dummy to avoid empty
    qs = "q="+esc(filters.search)+"&status="+esc(filters.status)+"&channel="+esc(filters.channel)+"&shop="+esc(filters.shop)+"&range="+esc(filters.range);
    if (extra) qs += "&" + extra;
    return "/orders?" + qs;
  }
  function badge(st){
    if (st==="EINGEGANGEN") return "badge";
    if (st==="FREIGEGEBEN") return "badge ok";
    if (st==="IN_PRODUKTION") return "badge";
    if (st==="VERPACKT") return "badge";
    if (st==="AUSGELIEFERT") return "badge ok";
    return "badge";
  }
%>

<% if (errMsg) { %>
  <div class="card" style="border-color: rgba(255,77,77,.35);"><h2>Fehler</h2><p><%= errMsg %></p></div>
<% } %>
<% if (okMsg) { %>
  <div class="card" style="border-color: rgba(38,201,122,.35);"><h2>OK</h2><p><%= okMsg %></p></div>
<% } %>

<div class="card-grid" style="grid-template-columns: 420px 1fr; align-items:start;">
  <!-- LEFT -->
  <div class="card">
    <h2>Bestellungen</h2>
    <p class="small-note">Suchen, filtern, auswählen. Offene Bestellungen stehen oben.</p>

    <form method="GET" action="/orders" class="mt-3">
      <div style="display:grid; gap:10px;">
        <input class="input" name="q" placeholder="Suche (ID, Kunde, Notiz, Sorte...)" value="<%= filters.search %>"/>

        <div class="row" style="gap:10px;">
          <select class="select" name="status" style="flex:1;">
            <option value="ALL" <%= filters.status==="ALL"?"selected":"" %>>Status: Alle</option>
            <option value="EINGEGANGEN" <%= filters.status==="EINGEGANGEN"?"selected":"" %>>Eingegangen</option>
            <option value="FREIGEGEBEN" <%= filters.status==="FREIGEGEBEN"?"selected":"" %>>Freigegeben</option>
            <option value="IN_PRODUKTION" <%= filters.status==="IN_PRODUKTION"?"selected":"" %>>In Produktion</option>
            <option value="VERPACKT" <%= filters.status==="VERPACKT"?"selected":"" %>>Verpackt</option>
            <option value="AUSGELIEFERT" <%= filters.status==="AUSGELIEFERT"?"selected":"" %>>Ausgeliefert</option>
          </select>

          <select class="select" name="range" style="width:140px;">
            <option value="7" <%= filters.range==="7"?"selected":"" %>>7 Tage</option>
            <option value="30" <%= filters.range==="30"?"selected":"" %>>30 Tage</option>
            <option value="90" <%= filters.range==="90"?"selected":"" %>>90 Tage</option>
          </select>
        </div>

        <% if (!shopMode) { %>
          <div class="row" style="gap:10px;">
            <select class="select" name="channel" style="flex:1;">
              <option value="ALL" <%= filters.channel==="ALL"?"selected":"" %>>Kanal: Alle</option>
              <option value="FILIALE" <%= filters.channel==="FILIALE"?"selected":"" %>>Filiale</option>
              <option value="B2B" <%= filters.channel==="B2B"?"selected":"" %>>B2B</option>
            </select>

            <select class="select" name="shop" style="flex:1;">
              <option value="ALL" <%= filters.shop==="ALL"?"selected":"" %>>Filiale: Alle</option>
              <% for (var s=0;s<shops.length;s++) { %>
                <option value="<%= shops[s].id %>" <%= String(filters.shop)===String(shops[s].id)?"selected":"" %>><%= shops[s].name %></option>
              <% } %>
            </select>
          </div>
        <% } %>

        <button class="btn btn-primary" type="submit">Filtern</button>
      </div>
    </form>

    <div class="mt-3" style="display:grid; gap:8px;">
      <% if (!orders.length) { %>
        <div class="small-note">Keine Bestellungen gefunden.</div>
      <% } %>

      <% for (var i=0;i<orders.length;i++) { 
           var o = orders[i];
           var isSel = selectedOrder && String(selectedOrder.id)===String(o.id);
      %>
        <a class="nav-item <%= isSel?'active':'' %>" style="text-decoration:none;"
           href="<%= buildLink('order='+esc(o.id)) %>">
          <div style="display:flex; flex-direction:column; gap:6px; width:100%;">
            <div class="row" style="justify-content:space-between;">
              <div style="font-weight:950;">
                <%= (o.channel==="B2B" ? (o.customerName || "B2B") : (o.shopId || "Filiale")) %>
              </div>
              <span class="<%= badge(o.status) %>"><span class="dot"></span><%= o.status %></span>
            </div>
            <div class="small-note mono">
              <%= o.deliveryDate %> · <%= (o.items||[]).length %> Pos · <%= o.id %>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  </div>

  <!-- RIGHT -->
  <div class="card">
    <h2>Editor</h2>
    <p class="small-note"><%= shopMode ? "Filiale: Bestellung anlegen & Status verfolgen." : "Admin: anlegen, freigeben, liefern." %></p>

    <% if (!selectedOrder) { %>
      <div class="card mt-3">
        <h2>Neue Bestellung</h2>
        <form id="orderForm" method="POST" action="/actions/orders/create">
          <input type="hidden" name="payload" id="payload" value="" />

          <div style="display:grid; gap:10px;">
            <div class="row" style="gap:10px;">
              <% if (!shopMode) { %>
                <select class="select" id="channel" style="flex:1;">
                  <option value="FILIALE">Kanal: Filiale</option>
                  <option value="B2B">Kanal: B2B</option>
                </select>
              <% } else { %>
                <div class="badge ok"><span class="dot"></span>FILIALE</div>
              <% } %>

              <input class="input" id="deliveryDate" type="date" style="width:220px;" />
            </div>

            <% if (!shopMode) { %>
              <div class="row" style="gap:10px;">
                <select class="select" id="shopId" style="flex:1;">
                  <option value="">Filiale wählen</option>
                  <% for (var s=0;s<shops.length;s++) { %>
                    <option value="<%= shops[s].id %>"><%= shops[s].name %> (<%= shops[s].id %>)</option>
                  <% } %>
                </select>

                <select class="select" id="b2bCustomer" style="flex:1; display:none;">
                  <option value="">B2B Kunde wählen</option>
                  <% for (var b=0;b<b2bCustomers.length;b++) { %>
                    <option value="<%= b2bCustomers[b].name %>"><%= b2bCustomers[b].name %></option>
                  <% } %>
                </select>
              </div>
            <% } else { %>
              <div class="small-note">Filiale: <span class="mono"><%= shopId %></span></div>
            <% } %>

            <input class="input" id="customerName" placeholder="B2B Kunde (falls B2B)" style="display:none;" />
            <input class="input" id="note" placeholder="Notiz (optional)" />

            <div class="card">
              <div class="row" style="justify-content:space-between;">
                <h2 style="margin:0;">Positionen</h2>
                <button class="btn btn-ghost" type="button" onclick="addItem()">+ Position</button>
              </div>
              <div class="small-note mt-2">Wählen Sie Sorte und Menge in kg.</div>

              <div id="items" class="mt-3" style="display:grid; gap:10px;"></div>
            </div>

            <button class="btn btn-primary" type="submit">Bestellung erstellen</button>
          </div>
        </form>
      </div>

    <% } else { %>
      <div class="card mt-3">
        <div class="row" style="justify-content:space-between;">
          <div>
            <h2 style="margin:0;">Bestellung</h2>
            <div class="small-note mono"><%= selectedOrder.id %></div>
          </div>
          <span class="<%= badge(selectedOrder.status) %>"><span class="dot"></span><%= selectedOrder.status %></span>
        </div>

        <div class="mt-3 small-note">
          Kanal: <span class="mono"><%= selectedOrder.channel %></span> ·
          Lieferdatum: <span class="mono"><%= selectedOrder.deliveryDate %></span>
        </div>

        <div class="mt-2 small-note">
          <%= selectedOrder.channel==="B2B" ? ("Kunde: " + (selectedOrder.customerName||"-")) : ("Filiale: " + (selectedOrder.shopId||"-")) %>
        </div>

        <% if (selectedOrder.note) { %>
          <div class="mt-2 small-note">Notiz: <%= selectedOrder.note %></div>
        <% } %>

        <div class="table-wrap mt-3">
          <div class="table-head" style="grid-template-columns: 1fr 140px;">
            <div>Sorte</div>
            <div class="right">kg</div>
          </div>
          <% for (var k=0;k<(selectedOrder.items||[]).length;k++) { %>
            <div class="table-row" style="grid-template-columns: 1fr 140px;">
              <div style="font-weight:950;"><%= selectedOrder.items[k].coffeeName %></div>
              <div class="right mono"><%= selectedOrder.items[k].kg %></div>
            </div>
          <% } %>
        </div>

        <div class="row mt-3" style="gap:10px; flex-wrap:wrap;">
          <% if (!shopMode) { %>
            <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/approve">
              <button class="btn btn-ghost" type="submit">Freigeben</button>
            </form>
            <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/advance">
              <button class="btn btn-primary" type="submit">Nächster Status</button>
            </form>
            <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/deliver" onsubmit="return confirm('Ausliefern? (zieht Röstkaffee ab)');">
              <button class="btn btn-ghost" type="submit">Ausliefern</button>
            </form>
            <form method="POST" action="/actions/orders/<%= selectedOrder.id %>/delete" onsubmit="return confirm('Bestellung löschen?');">
              <button class="btn btn-danger" type="submit">Löschen</button>
            </form>
          <% } else { %>
            <div class="small-note">Filialen können Status nur ansehen. (Admin macht Freigabe/Produktion/Auslieferung.)</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <div class="small-note mt-3">
      Seitenhinweis: Freigabe zählt für Produktionsbedarf. Ausliefern zieht Röstkaffee ab.
    </div>
  </div>
</div>

<script>
  const coffees = <%- JSON.stringify(coffees || []) %>;
  const shopMode = <%- JSON.stringify(!!shopMode) %>;
  const shopId = <%- JSON.stringify(shopId || "") %>;

  function el(tag, attrs={}, children=[]) {
    const n = document.createElement(tag);
    Object.keys(attrs).forEach(k => {
      if (k === "class") n.className = attrs[k];
      else if (k === "html") n.innerHTML = attrs[k];
      else n.setAttribute(k, attrs[k]);
    });
    (children||[]).forEach(c => n.appendChild(c));
    return n;
  }

  function addItem(prefCoffeeId="", prefKg="") {
    const wrap = el("div", { class: "row", style: "gap:10px; align-items:center;" });

    const sel = el("select", { class: "select", style: "flex:1;" });
    sel.appendChild(new Option("Sorte wählen", ""));
    coffees.forEach(c => sel.appendChild(new Option(c.name + " (" + c.id + ")", c.id)));
    sel.value = prefCoffeeId || "";

    const kg = el("input", { class: "input", type: "number", step: "0.1", min: "0", placeholder: "kg", style: "width:140px;" });
    if (prefKg) kg.value = prefKg;

    const del = el("button", { class: "btn btn-ghost", type: "button" });
    del.textContent = "Entfernen";
    del.onclick = () => wrap.remove();

    wrap.appendChild(sel);
    wrap.appendChild(kg);
    wrap.appendChild(del);

    document.getElementById("items").appendChild(wrap);
  }

  function syncChannelUI() {
    const ch = document.getElementById("channel");
    const channel = ch ? ch.value : "FILIALE";

    const shopSel = document.getElementById("shopId");
    const b2bSel = document.getElementById("b2bCustomer");
    const b2bName = document.getElementById("customerName");

    if (!shopMode) {
      if (channel === "B2B") {
        if (shopSel) shopSel.style.display = "none";
        if (b2bSel) b2bSel.style.display = "";
        if (b2bName) b2bName.style.display = "";
      } else {
        if (shopSel) shopSel.style.display = "";
        if (b2bSel) b2bSel.style.display = "none";
        if (b2bName) b2bName.style.display = "none";
      }
    }
  }

  // init
  if (document.getElementById("items")) {
    addItem();
    addItem();
  }
  const channelSel = document.getElementById("channel");
  if (channelSel) {
    channelSel.addEventListener("change", syncChannelUI);
    syncChannelUI();
  }

  const b2bSel = document.getElementById("b2bCustomer");
  if (b2bSel) {
    b2bSel.addEventListener("change", () => {
      const name = document.getElementById("customerName");
      if (name && b2bSel.value) name.value = b2bSel.value;
    });
  }

  const form = document.getElementById("orderForm");
  if (form) {
    form.addEventListener("submit", (e) => {
      const channel = shopMode ? "FILIALE" : (document.getElementById("channel")?.value || "FILIALE");
      const date = document.getElementById("deliveryDate")?.value || "";
      const note = document.getElementById("note")?.value || "";

      let payload = {
        channel,
        shopId: shopMode ? shopId : (document.getElementById("shopId")?.value || ""),
        customerName: (document.getElementById("customerName")?.value || ""),
        deliveryDate: date,
        note,
        items: []
      };

      // items
      const rows = Array.from(document.getElementById("items").children || []);
      rows.forEach(r => {
        const sel = r.querySelector("select");
        const kg = r.querySelector("input[type='number']");
        const coffeeId = sel ? sel.value : "";
        const kgVal = kg ? Number(kg.value) : 0;
        if (!coffeeId || !Number.isFinite(kgVal) || kgVal <= 0) return;
        const opt = sel.options[sel.selectedIndex];
        const coffeeName = opt ? opt.textContent.replace(/\s*\([^)]+\)\s*$/, "") : coffeeId;
        payload.items.push({ coffeeId, coffeeName, kg: kgVal });
      });

      document.getElementById("payload").value = JSON.stringify(payload);
    });
  }
</script>
